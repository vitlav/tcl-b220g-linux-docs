From 1e4248348bb5191468081bcb2d0dbc4b4d54ddca Mon Sep 17 00:00:00 2001
From: Nikita Travkin <nikita@trvn.ru>
Date: Tue, 15 Sep 2026 13:12:07 +0300
Subject: [PATCH] ASoC: q6afe: return the DSP vote handle under the transaction
 lock

Each LPASS hardware vote receives a DSP client handle which must accompany
its unvote. Previously the response handle was discarded and the clock
consumer retained its initial zero handle, so releasing the Linux clock
reference could fail to release the corresponding DSP vote.

Adapt Nikita Travkin's qc7 fix to the current cleanup-based allocation.
Keep the transaction mutex held through copying the successful response,
and use the downstream zero token for the unvote command. Retain the
caller's output on send failure, timeout or DSP error, reject undersized
responses before reading their two words, and preserve transport errno.
Omit the original unconditional debug warnings.

This does not provide response-token correlation for late replies after a
timeout, DSP reset recovery, or confirmation of the asynchronous unvote.
Those remain separate requirements for complete power-management support.

Original-commit: 2637dc2cbba04da60fce3156902ba0611a4b30a8
Fixes: 55e07531d922 ("ASoC: q6dsp: q6afe: add lpass hw voting support")
Signed-off-by: Nikita Travkin <nikita@trvn.ru>
---
 sound/soc/qcom/qdsp6/q6afe.c | 34 +++++++++++++++++++++++++---------
 1 file changed, 25 insertions(+), 9 deletions(-)

diff --git a/sound/soc/qcom/qdsp6/q6afe.c b/sound/soc/qcom/qdsp6/q6afe.c
index d28ffeede..162186d1e 100644
--- a/sound/soc/qcom/qdsp6/q6afe.c
+++ b/sound/soc/qcom/qdsp6/q6afe.c
@@ -380,6 +380,7 @@ struct q6afe {
 	struct q6core_svc_api_info ainfo;
 	struct mutex lock;
 	struct aprv2_ibasic_rsp_result_t result;
+	u32 rsp_client_handle;
 	wait_queue_head_t wait;
 	struct list_head port_list;
 	spinlock_t port_list_lock;
@@ -970,7 +971,7 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 	const struct apr_hdr *hdr = &data->hdr;
 	struct q6afe_port *port;
 
-	if (!data->payload_size)
+	if (data->payload_size < sizeof(*res))
 		return 0;
 
 	res = data->payload;
@@ -1002,8 +1003,10 @@ static int q6afe_callback(struct apr_device *adev, const struct apr_resp_pkt *da
 	}
 		break;
 	case AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST:
-		afe->result.opcode = hdr->opcode;
+		/* The first response word is the vote handle, not an opcode. */
+		afe->rsp_client_handle = res->opcode;
 		afe->result.status = res->status;
+		afe->result.opcode = hdr->opcode;
 		wake_up(&afe->wait);
 		break;
 	default:
@@ -1029,14 +1032,14 @@ int q6afe_get_port_id(int index)
 }
 EXPORT_SYMBOL_GPL(q6afe_get_port_id);
 
-static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
+static int afe_apr_send_pkt_locked(struct q6afe *afe, struct apr_pkt *pkt,
 			    struct q6afe_port *port, uint32_t rsp_opcode)
 {
 	wait_queue_head_t *wait;
 	struct aprv2_ibasic_rsp_result_t *result;
 	int ret;
 
-	mutex_lock(&afe->lock);
+	lockdep_assert_held(&afe->lock);
 	if (port) {
 		wait = &port->wait;
 		result = &port->result;
@@ -1051,8 +1054,7 @@ static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
 	ret = apr_send_pkt(afe->apr, pkt);
 	if (ret < 0) {
 		dev_err(afe->dev, "packet not transmitted (%d)\n", ret);
-		ret = -EINVAL;
-		goto err;
+		return ret;
 	}
 
 	ret = wait_event_timeout(*wait, (result->opcode == rsp_opcode),
@@ -1067,7 +1069,16 @@ static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
 		ret = 0;
 	}
 
-err:
+	return ret;
+}
+
+static int afe_apr_send_pkt(struct q6afe *afe, struct apr_pkt *pkt,
+			    struct q6afe_port *port, uint32_t rsp_opcode)
+{
+	int ret;
+
+	mutex_lock(&afe->lock);
+	ret = afe_apr_send_pkt_locked(afe, pkt, port, rsp_opcode);
 	mutex_unlock(&afe->lock);
 
 	return ret;
@@ -1855,7 +1866,7 @@ int q6afe_unvote_lpass_core_hw(struct device *dev, uint32_t hw_block_id,
 	pkt->hdr.pkt_size = pkt_size;
 	pkt->hdr.src_port = 0;
 	pkt->hdr.dest_port = 0;
-	pkt->hdr.token = hw_block_id;
+	pkt->hdr.token = 0;
 	pkt->hdr.opcode = AFE_CMD_REMOTE_LPASS_CORE_HW_DEVOTE_REQUEST;
 	vote_cfg->hw_block_id = hw_block_id;
 	vote_cfg->client_handle = client_handle;
@@ -1896,11 +1907,16 @@ int q6afe_vote_lpass_core_hw(struct device *dev, uint32_t hw_block_id,
 	strscpy(vote_cfg->client_name, client_name,
 			sizeof(vote_cfg->client_name));
 
-	ret = afe_apr_send_pkt(afe, pkt, NULL,
+	mutex_lock(&afe->lock);
+	ret = afe_apr_send_pkt_locked(afe, pkt, NULL,
 			       AFE_CMD_RSP_REMOTE_LPASS_CORE_HW_VOTE_REQUEST);
 	if (ret)
 		dev_err(afe->dev, "AFE failed to vote (%d)\n", hw_block_id);
 
+	else if (client_handle)
+		*client_handle = afe->rsp_client_handle;
+	mutex_unlock(&afe->lock);
+
 	return ret;
 }
 EXPORT_SYMBOL(q6afe_vote_lpass_core_hw);
-- 
2.50.1

