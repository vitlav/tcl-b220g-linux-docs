From 01ff5820569e5ef2bde6d2286ee38ebde52b3300 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Tue, 15 Sep 2026 11:41:43 +0300
Subject: [PATCH 25/70] drm: discover bridges and DSI devices through firmware
 nodes

Software-node display graphs need to identify DRM bridges and MIPI DSI
devices without OF nodes.

Add the optional bridge firmware-node identity and an owned-reference
lookup under the bridge-list lock. Extend the MIPI DSI interfaces used
by the supplemental graph so the board driver can identify the remote
device through firmware references. Providers keep node identities
alive, and callers release acquired bridge references. This supplies
graph plumbing; it does not initialize a physical bridge or panel.
---
 drivers/gpu/drm/drm_bridge.c   | 16 ++++++++++++++++
 drivers/gpu/drm/drm_mipi_dsi.c | 16 ++++++++++++++++
 include/drm/drm_bridge.h       |  3 +++
 include/drm/drm_mipi_dsi.h     |  1 +
 4 files changed, 36 insertions(+)

diff --git a/drivers/gpu/drm/drm_bridge.c b/drivers/gpu/drm/drm_bridge.c
index 687b36eea..4df889653 100644
--- a/drivers/gpu/drm/drm_bridge.c
+++ b/drivers/gpu/drm/drm_bridge.c
@@ -1515,6 +1515,22 @@ void drm_bridge_hpd_notify(struct drm_bridge *bridge,
 }
 EXPORT_SYMBOL_GPL(drm_bridge_hpd_notify);
 
+/* Return an owned bridge reference; callers release it with drm_bridge_put(). */
+struct drm_bridge *drm_fwnode_find_and_get_bridge(struct fwnode_handle *node)
+{
+	struct drm_bridge *bridge;
+
+	if (!node)
+		return NULL;
+	scoped_guard(mutex, &bridge_lock) {
+		list_for_each_entry(bridge, &bridge_list, list)
+			if (bridge->fwnode == node)
+				return drm_bridge_get(bridge);
+	}
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(drm_fwnode_find_and_get_bridge);
+
 #ifdef CONFIG_OF
 /**
  * of_drm_find_and_get_bridge - find the bridge corresponding to the device
diff --git a/drivers/gpu/drm/drm_mipi_dsi.c b/drivers/gpu/drm/drm_mipi_dsi.c
index 3ac1dd5ad..8eb487db3 100644
--- a/drivers/gpu/drm/drm_mipi_dsi.c
+++ b/drivers/gpu/drm/drm_mipi_dsi.c
@@ -328,6 +328,22 @@ struct mipi_dsi_host *of_find_mipi_dsi_host_by_node(struct device_node *node)
 }
 EXPORT_SYMBOL(of_find_mipi_dsi_host_by_node);
 
+/* Like the OF lookup, the caller must keep the host registered while in use. */
+struct mipi_dsi_host *fwnode_find_mipi_dsi_host(struct fwnode_handle *node)
+{
+	struct mipi_dsi_host *host;
+
+	if (!node)
+		return NULL;
+	scoped_guard(mutex, &host_lock) {
+		list_for_each_entry(host, &host_list, list)
+			if (dev_fwnode(host->dev) == node)
+				return host;
+	}
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(fwnode_find_mipi_dsi_host);
+
 int mipi_dsi_host_register(struct mipi_dsi_host *host)
 {
 	struct device_node *node;
diff --git a/include/drm/drm_bridge.h b/include/drm/drm_bridge.h
index 4ba3a5dee..1f8f10066 100644
--- a/include/drm/drm_bridge.h
+++ b/include/drm/drm_bridge.h
@@ -1108,6 +1108,8 @@ struct drm_bridge {
 	struct list_head chain_node;
 	/** @of_node: device node pointer to the bridge */
 	struct device_node *of_node;
+	/** @fwnode: optional firmware node, kept alive by the bridge provider */
+	struct fwnode_handle *fwnode;
 	/** @list: to keep track of all added bridges */
 	struct list_head list;
 	/**
@@ -1319,6 +1321,7 @@ void *__devm_drm_bridge_alloc(struct device *dev, size_t size, size_t offset,
 
 void drm_bridge_add(struct drm_bridge *bridge);
 int devm_drm_bridge_add(struct device *dev, struct drm_bridge *bridge);
+struct drm_bridge *drm_fwnode_find_and_get_bridge(struct fwnode_handle *node);
 void drm_bridge_remove(struct drm_bridge *bridge);
 int drm_bridge_attach(struct drm_encoder *encoder, struct drm_bridge *bridge,
 		      struct drm_bridge *previous,
diff --git a/include/drm/drm_mipi_dsi.h b/include/drm/drm_mipi_dsi.h
index b429acde4..d4b2317d7 100644
--- a/include/drm/drm_mipi_dsi.h
+++ b/include/drm/drm_mipi_dsi.h
@@ -111,6 +111,7 @@ struct mipi_dsi_host {
 int mipi_dsi_host_register(struct mipi_dsi_host *host);
 void mipi_dsi_host_unregister(struct mipi_dsi_host *host);
 struct mipi_dsi_host *of_find_mipi_dsi_host_by_node(struct device_node *node);
+struct mipi_dsi_host *fwnode_find_mipi_dsi_host(struct fwnode_handle *node);
 
 /* DSI mode flags */
 
