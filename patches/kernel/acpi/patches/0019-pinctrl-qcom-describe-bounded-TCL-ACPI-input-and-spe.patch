From 4f0b5194b0e18ad859708dedb67a6e401d56a362 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Tue, 15 Sep 2026 11:41:43 +0300
Subject: [PATCH 19/70] pinctrl: qcom: describe bounded TCL ACPI input and
 speaker GPIOs

ACPI GIO0 exposes one TLMM window for three tiles, while Linux normally
obtains named DT resources. The laptop requires known keyboard, bridge
and touchpad pin sets plus the speaker PA lines.

Map validated tile offsets within the ACPI window and restrict admission
by board identity, namespace, extent, interrupt and exact allowed pin
arrays. Include GPIO94 for the touchpad and the board speaker PA GPIOs
46/47 in the final description. Retain the earlier supported input sets
and omit the undescribed PDC wake mapping. This provides bounded normal
GPIO/IRQ access, not general wake support.
---
 drivers/pinctrl/qcom/pinctrl-msm.c    | 26 ++++++++-
 drivers/pinctrl/qcom/pinctrl-msm.h    |  5 ++
 drivers/pinctrl/qcom/pinctrl-sc7180.c | 77 +++++++++++++++++++++++++++
 3 files changed, 107 insertions(+), 1 deletion(-)

diff --git a/drivers/pinctrl/qcom/pinctrl-msm.c b/drivers/pinctrl/qcom/pinctrl-msm.c
index fd0add4e7..a9a5cd1e8 100644
--- a/drivers/pinctrl/qcom/pinctrl-msm.c
+++ b/drivers/pinctrl/qcom/pinctrl-msm.c
@@ -773,6 +773,18 @@ static int msm_gpio_init_valid_mask(struct gpio_chip *gc,
 	for (i = 0; i < len; i++)
 		set_bit(tmp[i], valid_mask);
 
+	/* Some board GPIOs are not described as input devices in ACPI. */
+	for (i = 0; i < pctrl->soc->nadditional_valid_gpios; i++) {
+		unsigned int gpio = pctrl->soc->additional_valid_gpios[i];
+
+		if (gpio >= ngpios) {
+			dev_err(pctrl->dev, "invalid additional GPIO %u\n", gpio);
+			ret = -EINVAL;
+			goto out;
+		}
+		set_bit(gpio, valid_mask);
+	}
+
 out:
 	kfree(tmp);
 	return ret;
@@ -1561,7 +1573,19 @@ int msm_pinctrl_probe(struct platform_device *pdev,
 
 	raw_spin_lock_init(&pctrl->lock);
 
-	if (soc_data->tiles) {
+	if (soc_data->acpi_tile_offsets) {
+		void __iomem *base;
+
+		base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+		if (IS_ERR(base))
+			return PTR_ERR(base);
+		for (i = 0; i < soc_data->ntiles; i++) {
+			if (soc_data->acpi_tile_offsets[i] >= resource_size(res))
+				return -EINVAL;
+			pctrl->regs[i] = base + soc_data->acpi_tile_offsets[i];
+			pctrl->phys_base[i] = res->start + soc_data->acpi_tile_offsets[i];
+		}
+	} else if (soc_data->tiles) {
 		for (i = 0; i < soc_data->ntiles; i++) {
 			res = platform_get_resource_byname(pdev, IORESOURCE_MEM,
 							   soc_data->tiles[i]);
diff --git a/drivers/pinctrl/qcom/pinctrl-msm.h b/drivers/pinctrl/qcom/pinctrl-msm.h
index b94ba1a41..479ad22f5 100644
--- a/drivers/pinctrl/qcom/pinctrl-msm.h
+++ b/drivers/pinctrl/qcom/pinctrl-msm.h
@@ -178,10 +178,15 @@ struct msm_pinctrl_soc_data {
 	bool pull_no_keeper;
 	const char *const *tiles;
 	unsigned int ntiles;
+	/* Optional tile offsets within one ACPI MMIO resource. */
+	const u32 *acpi_tile_offsets;
 	const int *reserved_gpios;
 	const struct msm_gpio_wakeirq_map *wakeirq_map;
 	unsigned int nwakeirq_map;
 	bool wakeirq_dual_edge_errata;
+	/* Additional GPIOs allowed by a board-specific ACPI whitelist. */
+	const unsigned int *additional_valid_gpios;
+	unsigned int nadditional_valid_gpios;
 	unsigned int gpio_func;
 	unsigned int egpio_func;
 };
diff --git a/drivers/pinctrl/qcom/pinctrl-sc7180.c b/drivers/pinctrl/qcom/pinctrl-sc7180.c
index a02a9a78a..5d04178ad 100644
--- a/drivers/pinctrl/qcom/pinctrl-sc7180.c
+++ b/drivers/pinctrl/qcom/pinctrl-sc7180.c
@@ -1,6 +1,9 @@
 // SPDX-License-Identifier: GPL-2.0
 // Copyright (c) 2019, The Linux Foundation. All rights reserved.
 
+#include <linux/acpi.h>
+#include <linux/dmi.h>
+#include <linux/irq.h>
 #include <linux/module.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -1139,8 +1142,81 @@ static const struct msm_pinctrl_soc_data sc7180_pinctrl = {
 	.wakeirq_dual_edge_errata = true,
 };
 
+#ifdef CONFIG_ACPI
+/* ACPI GIO0 covers all three tiles; DT keeps named resources. */
+static const u32 sc7180_acpi_tile_offsets[] = {
+	[NORTH] = 0x500000, [SOUTH] = 0x900000, [WEST] = 0x100000,
+};
+
+/* TCL B220G speaker PA enable lines; DT audio testing confirmed GPIO46/47. */
+static const unsigned int tcl_b220g_speaker_pa_gpios[] = { 46, 47 };
+
+static int sc7180_pinctrl_acpi_probe(struct platform_device *pdev)
+{
+	struct msm_pinctrl_soc_data *soc;
+	struct resource *res;
+	struct irq_data *irqdata;
+	acpi_handle handle;
+	static const u16 keyboard_pins[] = { 32, 33, 115, 116 };
+	static const u16 display_pins[] = { 32, 33, 86, 87, 115, 116 };
+	static const u16 touchpad_pins[] = { 32, 33, 86, 87, 94, 115, 116 };
+	const u16 *expected;
+	u16 pins[ARRAY_SIZE(touchpad_pins)];
+	int irq, count;
+
+	if (!dmi_match(DMI_SYS_VENDOR, "TCL Communication Ltd.") ||
+	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
+	    !device_property_read_bool(&pdev->dev, "qcom,tcl-acpi-input") ||
+	    ACPI_FAILURE(acpi_get_handle(NULL, "\\_SB.GIO0", &handle)) ||
+	    handle != ACPI_HANDLE(&pdev->dev))
+		return -ENODEV;
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x3400000 || resource_size(res) != 0xc00000)
+		return -EINVAL;
+	/* Exact sets preserve earlier boots; TCPD uses GPIO94 as level-low IRQ. */
+	count = device_property_count_u16(&pdev->dev, "gpios");
+	if (count == ARRAY_SIZE(keyboard_pins))
+		expected = keyboard_pins;
+	else if (count == ARRAY_SIZE(display_pins))
+		expected = display_pins;
+	else if (count == ARRAY_SIZE(touchpad_pins))
+		expected = touchpad_pins;
+	else
+		return -EINVAL;
+	if (device_property_read_u16_array(&pdev->dev, "gpios", pins, count) ||
+	    memcmp(pins, expected, count * sizeof(pins[0])))
+		return -EINVAL;
+	irq = platform_get_irq(pdev, 0);
+	if (irq < 0)
+		return irq;
+	irqdata = irq_get_irq_data(irq);
+	if (!irqdata || irqd_to_hwirq(irqdata) != 240)
+		return -EINVAL;
+	soc = devm_kmemdup(&pdev->dev, &sc7180_pinctrl, sizeof(*soc), GFP_KERNEL);
+	if (!soc)
+		return -ENOMEM;
+	soc->acpi_tile_offsets = sc7180_acpi_tile_offsets;
+	/* Normal input uses the TLMM summary IRQ; PDC wake is not described. */
+	soc->wakeirq_map = NULL;
+	soc->nwakeirq_map = 0;
+	soc->additional_valid_gpios = tcl_b220g_speaker_pa_gpios;
+	soc->nadditional_valid_gpios = ARRAY_SIZE(tcl_b220g_speaker_pa_gpios);
+	dev_info(&pdev->dev, "TCL ACPI input GPIO whitelist: %d pins; summary GSI240\n", count);
+	return msm_pinctrl_probe(pdev, soc);
+}
+
+static const struct acpi_device_id sc7180_pinctrl_acpi_match[] = {
+	{ "QCOM080D" }, { }
+};
+MODULE_DEVICE_TABLE(acpi, sc7180_pinctrl_acpi_match);
+#endif
+
 static int sc7180_pinctrl_probe(struct platform_device *pdev)
 {
+#ifdef CONFIG_ACPI
+	if (has_acpi_companion(&pdev->dev))
+		return sc7180_pinctrl_acpi_probe(pdev);
+#endif
 	return msm_pinctrl_probe(pdev, &sc7180_pinctrl);
 }
 
@@ -1155,6 +1231,7 @@ static struct platform_driver sc7180_pinctrl_driver = {
 		.name = "sc7180-pinctrl",
 		.pm = &msm_pinctrl_dev_pm_ops,
 		.of_match_table = sc7180_pinctrl_of_match,
+		.acpi_match_table = ACPI_PTR(sc7180_pinctrl_acpi_match),
 	},
 	.probe = sc7180_pinctrl_probe,
 };
