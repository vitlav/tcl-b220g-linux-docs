From e952b3c603fac0ab59e855149fa6200dfd768e1f Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Tue, 15 Sep 2026 11:41:43 +0300
Subject: [PATCH 17/36] soc: qcom: enumerate APR services from firmware nodes

ADSP GLINK channels described by software nodes cannot populate APR
service children through OF-only parsing. Failed child creation must
also balance device, node and IDR ownership.

Match service compatibles through device properties, parse the domain
and protection-domain descriptions through firmware-node APIs, and
register APR children with balanced initialization/release. Add the
RPMsg match for the firmware-described channel and unwind partial
registration. This provides the service bus; Q6ADM/Q6AFE/Q6ASM drivers
and board-created properties still define the actual audio services.
---
 drivers/soc/qcom/apr.c | 152 ++++++++++++++++++++++++-----------------
 1 file changed, 88 insertions(+), 64 deletions(-)

diff --git a/drivers/soc/qcom/apr.c b/drivers/soc/qcom/apr.c
index ea7f83916d8d8dcbaebcbd594e479d0ce4eb6ec7..18ac23ee567b31af3186962009cbf02528c8f9a2 100644
--- a/drivers/soc/qcom/apr.c
+++ b/drivers/soc/qcom/apr.c
@@ -10,6 +10,7 @@
 #include <linux/slab.h>
 #include <linux/workqueue.h>
 #include <linux/of_device.h>
+#include <linux/property.h>
 #include <linux/soc/qcom/apr.h>
 #include <linux/soc/qcom/pdr.h>
 #include <linux/rpmsg.h>
@@ -155,6 +156,7 @@ static void apr_dev_release(struct device *dev)
 {
 	struct apr_device *adev = to_apr_device(dev);
 
+	fwnode_handle_put(dev_fwnode(dev));
 	kfree(adev);
 }
 
@@ -348,6 +350,16 @@ static int apr_device_match(struct device *dev, const struct device_driver *drv)
 	if (of_driver_match_device(dev, drv))
 		return 1;
 
+	/* Software nodes describe ACPI board services using the same compatibles. */
+	if (is_software_node(dev_fwnode(dev)) && drv->of_match_table) {
+		const struct of_device_id *match;
+
+		for (match = drv->of_match_table; match->compatible[0]; match++)
+			if (device_property_match_string(dev, "compatible",
+						 match->compatible) >= 0)
+				return 1;
+	}
+
 	if (!id)
 		return 0;
 
@@ -408,94 +420,101 @@ const struct bus_type aprbus = {
 };
 EXPORT_SYMBOL_GPL(aprbus);
 
-static int apr_add_device(struct device *dev, struct device_node *np,
+/* APR bindings define at most two protection-domain strings. */
+static int apr_read_pd_string(const struct fwnode_handle *node,
+			      unsigned int index, const char **value)
+{
+	const char *strings[2];
+	int ret;
+
+	if (index >= ARRAY_SIZE(strings))
+		return -EINVAL;
+	ret = fwnode_property_read_string_array(node, "qcom,protection-domain",
+					       strings, index + 1);
+	if (ret < 0)
+		return ret;
+	if (ret <= index)
+		return -EINVAL;
+	*value = strings[index];
+	return 0;
+}
