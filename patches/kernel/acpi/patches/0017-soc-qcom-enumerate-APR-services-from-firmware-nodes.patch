 	dev_info(dev, "Adding APR/GPR dev: %s\n", dev_name(&adev->dev));
-
-	ret = device_register(&adev->dev);
-	if (ret) {
-		dev_err(dev, "device_register failed: %d\n", ret);
-		put_device(&adev->dev);
