From d9b9c2fc4dc5b007ef417b4d293ec4fe99787cac Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 13:22:06 +0300
Subject: [PATCH 22/58] drm: msm: obtain explicit clocks for non-OF display
 consumers

The MSM clock helper enumerates clocks through OF, which yields no
usable clock list for supplemental ACPI MDSS/DPU devices. Their
coordinator supplies clock-names and explicit lookup aliases instead.

Add a helper that reads the non-OF clock-name list and acquires the
named clocks with managed lifetime, preserving the OF acquisition path.
Use it from MDSS and DPU probe. Missing clocks and supplier deferral
must propagate to the consumer rather than allowing register access with
incomplete clock setup.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c |  2 +-
 drivers/gpu/drm/msm/msm_drv.h           |  1 +
 drivers/gpu/drm/msm/msm_io_utils.c      | 49 +++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_mdss.c          |  2 +-
 4 files changed, 52 insertions(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index da3556eb6ecc25a53440787dd35ab79f7e887545..8386b655b67c5e24caa559e38ac89bdda6b585be 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1400,7 +1400,7 @@ static int dpu_dev_probe(struct platform_device *pdev)
 	if (ret && ret != -ENODEV)
 		return dev_err_probe(dev, ret, "invalid OPP table in device tree\n");
 
-	ret = devm_clk_bulk_get_all(&pdev->dev, &dpu_kms->clocks);
+	ret = msm_devm_clk_bulk_get_all(&pdev->dev, &dpu_kms->clocks);
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "failed to parse clocks\n");
 
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index 3787db8770adae74b6149b708d59739afad3af79..aeaaa942e45237552957dc5def8f209ef5fe2d40 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -452,6 +452,7 @@ static inline void msm_rd_debugfs_cleanup(struct msm_drm_private *priv) {}
 
 struct clk *msm_clk_get(struct platform_device *pdev, const char *name);
 
+int msm_devm_clk_bulk_get_all(struct device *dev, struct clk_bulk_data **clks);
 struct clk *msm_clk_bulk_get_clock(struct clk_bulk_data *bulk, int count,
 	const char *name);
 void __iomem *msm_ioremap(struct platform_device *pdev, const char *name);
diff --git a/drivers/gpu/drm/msm/msm_io_utils.c b/drivers/gpu/drm/msm/msm_io_utils.c
index a6efe1eac271219419eafdd80bce5aba67b4fbea..a35aae240c132690415e90e1f4642faf9eb6072d 100644
--- a/drivers/gpu/drm/msm/msm_io_utils.c
+++ b/drivers/gpu/drm/msm/msm_io_utils.c
@@ -7,6 +7,7 @@
 
 #include <linux/interconnect.h>
 #include <linux/io.h>
+#include <linux/property.h>
 
 #include "msm_drv.h"
 
@@ -14,6 +15,54 @@
  * Util/helpers:
  */
 
+/* clk_bulk_get_all() only enumerates OF providers. ACPI/software-node
+ * consumers must name their clkdev lookups explicitly.
+ */
+int msm_devm_clk_bulk_get_all(struct device *dev, struct clk_bulk_data **clks)
+{
+	struct clk_bulk_data *bulk;
+	const char **names;
+	int count, ret, i;
+
+	if (dev->of_node)
+		return devm_clk_bulk_get_all(dev, clks);
+
+	*clks = NULL;
+	count = device_property_string_array_count(dev, "clock-names");
+	if (count <= 0)
+		return count ?: -EINVAL;
+
+	names = kcalloc(count, sizeof(*names), GFP_KERNEL);
+	if (!names)
+		return -ENOMEM;
+	ret = device_property_read_string_array(dev, "clock-names", names, count);
+	if (ret != count) {
+		ret = ret < 0 ? ret : -EINVAL;
+		goto free_names;
+	}
+
+	bulk = devm_kcalloc(dev, count, sizeof(*bulk), GFP_KERNEL);
+	if (!bulk) {
+		ret = -ENOMEM;
+		goto free_names;
+	}
+	for (i = 0; i < count; i++) {
+		if (!names[i] || !names[i][0]) {
+			ret = -EINVAL;
+			goto free_names;
+		}
+		bulk[i].id = names[i];
+	}
+	ret = devm_clk_bulk_get(dev, count, bulk);
+	if (!ret) {
+		*clks = bulk;
+		ret = count;
+	}
+free_names:
+	kfree(names);
+	return ret;
+}
+
 struct clk *msm_clk_bulk_get_clock(struct clk_bulk_data *bulk, int count,
 		const char *name)
 {
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9087c4b290dba55822dbbce3b14d868e9f5790a7..9820b57df3921d40d6522ae0d5937241c136db2c 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -400,7 +400,7 @@ static struct msm_mdss *msm_mdss_init(struct platform_device *pdev, bool is_mdp5
 	if (is_mdp5)
 		ret = mdp5_mdss_parse_clock(pdev, &msm_mdss->clocks);
 	else
-		ret = devm_clk_bulk_get_all(&pdev->dev, &msm_mdss->clocks);
+		ret = msm_devm_clk_bulk_get_all(&pdev->dev, &msm_mdss->clocks);
 	if (ret < 0) {
 		dev_err(&pdev->dev, "failed to parse clocks, ret=%d\n", ret);
 		return ERR_PTR(ret);
