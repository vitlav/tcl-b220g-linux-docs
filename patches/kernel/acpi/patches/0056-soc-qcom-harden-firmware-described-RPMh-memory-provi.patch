From a184a80e308e37efe2ee0e3e55d19d5d5406ac5c Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sat, 19 Sep 2026 04:35:08 +0300
Subject: [PATCH 56/70] soc: qcom: harden firmware-described RPMh memory
 providers

Allow an ACPI-described RPMh RSC instance to use its sole MMIO and IRQ resources by index because ACPI _CRS has no DT reg-names. Require command DB and RMTFS firmware resources to be wholly covered by EFI reserved-memory descriptors before mapping them.

Signed-off-by: Vitaly Lipatov <lav@etersoft.ru>
---
 drivers/soc/qcom/cmd-db.c    | 29 +++++++++++++++++++++++++++++
 drivers/soc/qcom/rmtfs_mem.c | 29 +++++++++++++++++++++++++++++
 drivers/soc/qcom/rpmh-rsc.c  |  6 ++++--
 3 files changed, 62 insertions(+), 2 deletions(-)

diff --git a/drivers/soc/qcom/cmd-db.c b/drivers/soc/qcom/cmd-db.c
index c1d8669b7..de0626195 100644
--- a/drivers/soc/qcom/cmd-db.c
+++ b/drivers/soc/qcom/cmd-db.c
@@ -4,8 +4,10 @@
  * Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
+#include <linux/acpi.h>
 #include <linux/bitfield.h>
 #include <linux/debugfs.h>
+#include <linux/efi.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
 #include <linux/of.h>
@@ -24,6 +26,29 @@
 #define SLAVE_ID(addr)		FIELD_GET(GENMASK(19, 16), addr)
 #define VRM_ADDR(addr)		FIELD_GET(GENMASK(19, 4), addr)
 
+static int cmd_db_validate_acpi_resource(struct device *dev,
+					 const struct resource *res)
+{
+#if IS_ENABLED(CONFIG_ACPI) && IS_ENABLED(CONFIG_EFI)
+	efi_memory_desc_t md;
+	u64 size;
+
+	if (!is_acpi_device_node(dev_fwnode(dev)))
+		return 0;
+	if (!efi_enabled(EFI_MEMMAP) || efi_mem_desc_lookup(res->start, &md) ||
+	    md.type != EFI_RESERVED_TYPE ||
+	    md.num_pages > (U64_MAX >> EFI_PAGE_SHIFT))
+		return -EINVAL;
+
+	size = md.num_pages << EFI_PAGE_SHIFT;
+	if (md.phys_addr > res->start || size < resource_size(res) ||
+	    res->start - md.phys_addr > size - resource_size(res))
+		return -EINVAL;
+#endif
+
+	return 0;
+}
+
 /**
  * struct entry_header: header for each entry in cmddb
  *
@@ -356,6 +381,10 @@ static int cmd_db_dev_probe(struct platform_device *pdev)
 		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 		if (!res || resource_size(res) < sizeof(*cmd_db_header))
 			return -EINVAL;
+		ret = cmd_db_validate_acpi_resource(&pdev->dev, res);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+					     "ACPI command DB resource is not UEFI-reserved\n");
 		base = res->start;
 		size = resource_size(res);
 	}
diff --git a/drivers/soc/qcom/rmtfs_mem.c b/drivers/soc/qcom/rmtfs_mem.c
index b02d958ca..75b320e0c 100644
--- a/drivers/soc/qcom/rmtfs_mem.c
+++ b/drivers/soc/qcom/rmtfs_mem.c
@@ -3,8 +3,10 @@
  * Copyright (c) 2017 Linaro Ltd.
  */
 
+#include <linux/acpi.h>
 #include <linux/kernel.h>
 #include <linux/cdev.h>
+#include <linux/efi.h>
 #include <linux/err.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
@@ -35,6 +37,29 @@ struct qcom_rmtfs_mem {
 	u64 perms;
 };
 
+static int qcom_rmtfs_validate_acpi_resource(struct device *dev,
+					      const struct resource *res)
+{
+#if IS_ENABLED(CONFIG_ACPI) && IS_ENABLED(CONFIG_EFI)
+	efi_memory_desc_t md;
+	u64 size;
+
+	if (!is_acpi_device_node(dev_fwnode(dev)))
+		return 0;
+	if (!efi_enabled(EFI_MEMMAP) || efi_mem_desc_lookup(res->start, &md) ||
+	    md.type != EFI_RESERVED_TYPE ||
+	    md.num_pages > (U64_MAX >> EFI_PAGE_SHIFT))
+		return -EINVAL;
+
+	size = md.num_pages << EFI_PAGE_SHIFT;
+	if (md.phys_addr > res->start || size < resource_size(res) ||
+	    res->start - md.phys_addr > size - resource_size(res))
+		return -EINVAL;
+#endif
+
+	return 0;
+}
+
 static ssize_t qcom_rmtfs_mem_show(struct device *dev,
 			      struct device_attribute *attr,
 			      char *buf);
@@ -193,6 +218,10 @@ static int qcom_rmtfs_mem_probe(struct platform_device *pdev)
 		res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
 		if (!res || !resource_size(res))
 			return -EINVAL;
+		ret = qcom_rmtfs_validate_acpi_resource(&pdev->dev, res);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret,
+					     "ACPI RMTFS resource is not UEFI-reserved\n");
 		base = res->start;
 		size = resource_size(res);
 	}
diff --git a/drivers/soc/qcom/rpmh-rsc.c b/drivers/soc/qcom/rpmh-rsc.c
index 277a2d75a..1f212de21 100644
--- a/drivers/soc/qcom/rpmh-rsc.c
+++ b/drivers/soc/qcom/rpmh-rsc.c
@@ -1060,7 +1060,9 @@ static int rpmh_rsc_probe(struct platform_device *pdev)
 		drv->name = dev_name(&pdev->dev);
 
 	snprintf(drv_id, ARRAY_SIZE(drv_id), "drv-%d", drv->id);
-	drv->base = devm_platform_ioremap_resource_byname(pdev, drv_id);
+	drv->base = pdev->dev.of_node ?
+		devm_platform_ioremap_resource_byname(pdev, drv_id) :
+		devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(drv->base))
 		return PTR_ERR(drv->base);
 
@@ -1084,7 +1086,7 @@ static int rpmh_rsc_probe(struct platform_device *pdev)
 	bitmap_zero(drv->tcs_in_use, MAX_TCS_NR);
 
 	irq = pdev->dev.of_node ? platform_get_irq(pdev, drv->id) :
-		platform_get_irq_byname(pdev, drv_id);
+		platform_get_irq(pdev, 0);
 	if (irq < 0)
 		return irq;
 
