 drivers/gpu/drm/msm/msm_drv.c           |  71 +++++++++++++++
 drivers/gpu/drm/msm/msm_drv.h           |   3 +
 drivers/gpu/drm/msm/msm_io_utils.c      | 108 +++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_mdss.c          |  64 ++++++++++++--
 5 files changed, 341 insertions(+), 16 deletions(-)

