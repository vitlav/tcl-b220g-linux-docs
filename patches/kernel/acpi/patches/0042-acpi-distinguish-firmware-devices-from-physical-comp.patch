 		{ "QCOM083A" }, { }
-	    }, dev->parent->parent))
+	    }, acpi_companion_or_self(dev->parent->parent)))
 		return -ENODEV;
 
 	res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "mdp");
