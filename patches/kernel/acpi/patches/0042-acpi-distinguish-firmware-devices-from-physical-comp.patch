From 37a6e3492e9dddeb76b90db3ddfdc4fe9f6d9fa9 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 18:13:49 +0300
Subject: [PATCH 42/58] acpi: distinguish firmware devices from physical
 companions in TCL display

---
 drivers/acpi/bus.c                      | 18 ++++++++++++++++++
 drivers/base/platform.c                 |  2 +-
 drivers/clk/qcom/dispcc-sc7180.c        |  6 +++---
 drivers/clk/qcom/gcc-sc7180.c           |  6 +++---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c |  6 +++---
 drivers/gpu/drm/msm/dsi/dsi.c           |  2 +-
 drivers/gpu/drm/msm/dsi/phy/dsi_phy.c   |  6 +++---
 drivers/gpu/drm/msm/msm_mdss.c          |  6 +++---
 drivers/soc/qcom/tcl_acpi_display.c     |  6 ++++--
 include/linux/acpi.h                    |  7 +++++++
 10 files changed, 46 insertions(+), 19 deletions(-)

diff --git a/drivers/acpi/bus.c b/drivers/acpi/bus.c
index a30a904f6535f4025790a83457aff92d8f0c60be..13e58a1724ac6029f1384f64e31e4578b73bdad2 100644
--- a/drivers/acpi/bus.c
+++ b/drivers/acpi/bus.c
@@ -1042,6 +1042,24 @@ static bool __acpi_match_device(const struct acpi_device *device,
 	return true;
 }
 
+/**
+ * acpi_companion_or_self - Find the ACPI object represented by a device
+ * @dev: Firmware device or physical device, or NULL.
+ *
+ * Return the device itself for an ACPI bus object, otherwise its companion.
+ * The returned pointer is borrowed; callers must keep @dev alive. This does
+ * not perform the primary-physical-device check used for driver matching.
+ */
+struct acpi_device *acpi_companion_or_self(struct device *dev)
+{
+	if (!dev)
+		return NULL;
+	if (dev->bus == &acpi_bus_type)
+		return to_acpi_device(dev);
+	return ACPI_COMPANION(dev);
+}
+EXPORT_SYMBOL_GPL(acpi_companion_or_self);
+
 /**
  * acpi_match_acpi_device - Match an ACPI device against a given list of ACPI IDs
  * @ids: Array of struct acpi_device_id objects to match against.
diff --git a/drivers/base/platform.c b/drivers/base/platform.c
index 06e44fb2bd04af9ad75f9b578bbcfc255545b1f8..79169c2c8998cf8600005e6d1766ad86d1116d44 100644
--- a/drivers/base/platform.c
+++ b/drivers/base/platform.c
@@ -1488,7 +1488,7 @@ static int platform_dma_configure(struct device *dev)
 		/* Supplemental DPU keeps its software node and MDSS parent. */
 		if (!dev->parent || !dev->parent->parent)
 			return -ENODEV;
-		adev = ACPI_COMPANION(dev->parent->parent);
+		adev = acpi_companion_or_self(dev->parent->parent);
 		if (!adev)
 			return -ENODEV;
 		attr = acpi_get_dma_attr(adev);
