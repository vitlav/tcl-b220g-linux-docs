@@ -728,10 +728,10 @@ static int disp_cc_sc7180_platform_prepare(struct platform_device *pdev)
 	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
 	    !device_property_read_bool(dev, "qcom,tcl-acpi-display") ||
 	    ACPI_FAILURE(acpi_get_handle(NULL, "\\_SB.GPU0", &gpu)) ||
-	    ACPI_HANDLE(dev->parent) != gpu)
+	    acpi_device_handle(acpi_companion_or_self(dev->parent)) != gpu)
 		return -ENODEV;
-	if (!acpi_match_device((const struct acpi_device_id[]) {
-		{ "QCOM083A" }, { } }, dev->parent))
+	if (!acpi_match_acpi_device((const struct acpi_device_id[]) {
+		{ "QCOM083A" }, { } }, acpi_companion_or_self(dev->parent)))
 		return -ENODEV;
 
 	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
diff --git a/drivers/clk/qcom/gcc-sc7180.c b/drivers/clk/qcom/gcc-sc7180.c
index ecec3c51bd126d97efff024a4fdfe802b4dca84a..26926df4d795e047cb4da3c33b06927648bda41b 100644
