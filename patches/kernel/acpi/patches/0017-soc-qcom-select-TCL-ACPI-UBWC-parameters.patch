From 2384ad0709956f075317c50035997aa180291b78 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 13:22:06 +0300
Subject: [PATCH 17/58] soc: qcom: select TCL ACPI UBWC parameters

UBWC configuration selection normally uses the DT root compatible. An
ACPI boot has no OF root, although the TCL display and GPU still require
the SC7180 compression layout.

Add an ACPI fallback that checks the TCL B220G DMI identity and the
QCOM083A device at the expected GPU0 namespace handle before returning
sc7180_data. Reject unmatched systems instead of choosing a generic UBWC
layout. This selects shared compression parameters only; it does not
instantiate the display or GPU.
---
 drivers/soc/qcom/ubwc_config.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/soc/qcom/ubwc_config.c b/drivers/soc/qcom/ubwc_config.c
index 3fe47d8f0f638c130efcd0a33daf244e4ea8d1ed..37fa57fa3e42e76e702fc36cbfdf4e8e367a0c48 100644
--- a/drivers/soc/qcom/ubwc_config.c
+++ b/drivers/soc/qcom/ubwc_config.c
@@ -3,6 +3,8 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 
+#include <linux/acpi.h>
+#include <linux/dmi.h>
 #include <linux/debugfs.h>
 #include <linux/io.h>
 #include <linux/module.h>
@@ -300,10 +302,38 @@ static const struct of_device_id qcom_ubwc_configs[] __maybe_unused = {
 	{ }
 };
 
+/* OEM ACPI describes B220G hardware but has no DT root compatible. */
+static const struct qcom_ubwc_cfg_data *qcom_ubwc_config_get_acpi_data(void)
+{
+#ifdef CONFIG_ACPI
+	struct acpi_device *adev;
+	acpi_handle handle;
+	bool match;
+
+	if (acpi_disabled ||
+	    !dmi_match(DMI_SYS_VENDOR, "TCL Communication Ltd.") ||
+	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
+	    ACPI_FAILURE(acpi_get_handle(NULL, "\\_SB.GPU0", &handle)))
+		return ERR_PTR(-ENODEV);
+
+	adev = acpi_dev_get_first_match_dev("QCOM083A", NULL, -1);
+	if (!adev)
+		return ERR_PTR(-ENODEV);
+	match = adev->handle == handle;
+	acpi_dev_put(adev);
+	if (match)
+		return &sc7180_data;
+#endif
+	return ERR_PTR(-ENODEV);
+}
+
 const struct qcom_ubwc_cfg_data *qcom_ubwc_config_get_data(void)
 {
 	const struct qcom_ubwc_cfg_data *data;
 
+	if (!of_root)
+		return qcom_ubwc_config_get_acpi_data();
+
 	data = of_machine_get_match_data(qcom_ubwc_configs);
 	if (!data) {
 		pr_err("Couldn't find UBWC config data for this platform!\n");
