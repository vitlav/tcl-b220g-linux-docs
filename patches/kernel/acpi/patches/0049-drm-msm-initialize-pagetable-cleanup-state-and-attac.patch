From 2e300ba47215d525a4bfed84971479849b27aa72 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 20:24:43 +0300
Subject: [PATCH 49/58] drm/msm: initialize pagetable cleanup state and attach
 TCL SMMU power

---
 drivers/gpu/drm/msm/msm_iommu.c | 10 ++++----
 drivers/soc/qcom/tcl_acpi_gpu.c | 42 ++++++++++++++++++++++++++++++++-
 2 files changed, 46 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/msm/msm_iommu.c b/drivers/gpu/drm/msm/msm_iommu.c
index 897e42c8d5c847031197088796aa2af890749678..b01ef287083262bc1c0ee28e805107498d74b06a 100644
--- a/drivers/gpu/drm/msm/msm_iommu.c
+++ b/drivers/gpu/drm/msm/msm_iommu.c
@@ -453,7 +453,7 @@ static void msm_iommu_tlb_flush_all(void *cookie)
 	struct msm_iommu_pagetable *pagetable = cookie;
 	struct adreno_smmu_priv *adreno_smmu;
 
-	if (!pm_runtime_get_if_in_use(pagetable->iommu_dev))
+	if (pm_runtime_get_if_in_use(pagetable->iommu_dev) <= 0)
 		return;
 
 	adreno_smmu = dev_get_drvdata(pagetable->parent->dev);
@@ -469,7 +469,7 @@ static void msm_iommu_tlb_flush_walk(unsigned long iova, size_t size,
 	struct msm_iommu_pagetable *pagetable = cookie;
 	struct adreno_smmu_priv *adreno_smmu;
 
-	if (!pm_runtime_get_if_in_use(pagetable->iommu_dev))
+	if (pm_runtime_get_if_in_use(pagetable->iommu_dev) <= 0)
 		return;
 
 	adreno_smmu = dev_get_drvdata(pagetable->parent->dev);
@@ -567,6 +567,9 @@ struct msm_mmu *msm_iommu_pagetable_create(struct msm_mmu *parent, bool kernel_m
 		ttbr0_cfg.pgsize_bitmap = PAGE_SIZE;
 	}
 
+	/* alloc/free_io_pgtable_ops can invoke TLB callbacks on error paths. */
+	pagetable->parent = parent;
+	pagetable->tlb = ttbr1_cfg->tlb;
 	pagetable->iommu_dev = ttbr1_cfg->iommu_dev;
 	pagetable->pgtbl_ops = alloc_io_pgtable_ops(ARM_64_LPAE_S1,
 		&ttbr0_cfg, pagetable);
@@ -612,9 +615,6 @@ struct msm_mmu *msm_iommu_pagetable_create(struct msm_mmu *parent, bool kernel_m
 	}
 	mutex_unlock(&iommu->init_lock);
 
-	/* Needed later for TLB flush */
-	pagetable->parent = parent;
-	pagetable->tlb = ttbr1_cfg->tlb;
 	pagetable->pgsize_bitmap = ttbr0_cfg.pgsize_bitmap;
 	pagetable->ttbr = ttbr0_cfg.arm_lpae_s1_cfg.ttbr;
 
diff --git a/drivers/soc/qcom/tcl_acpi_gpu.c b/drivers/soc/qcom/tcl_acpi_gpu.c
index 4a92a84a5b20b4689078bdc62c2a944b09861983..f635863b8ccd2e5034d82e270c4e5fe81649c52a 100644
--- a/drivers/soc/qcom/tcl_acpi_gpu.c
+++ b/drivers/soc/qcom/tcl_acpi_gpu.c
@@ -156,6 +156,43 @@ static int prepare_clock_controller(void)
 	return tcl_display_stage_activate(&cc);
 }
 
+static int match_adreno_smmu(struct device *dev, const void *unused)
+{
+	struct resource *res;
+
+	if (!dev->driver || strcmp(dev->driver->name, "arm-smmu"))
+		return 0;
+	res = platform_get_resource(to_platform_device(dev), IORESOURCE_MEM, 0);
+	return res && res->start == 0x5040000 && resource_size(res) == 0x10000;
+}
+
+static int attach_smmu_domain(struct generic_pm_domain *domain)
+{
+	struct device *smmu = bus_find_device(&platform_bus_type, NULL, NULL,
+					    match_adreno_smmu);
+	int ret;
+
+	if (!smmu)
+		return -EPROBE_DEFER;
+	if (smmu->pm_domain || pm_runtime_enabled(smmu)) {
+		put_device(smmu);
+		return -EBUSY;
+	}
+	ret = pm_genpd_add_device(domain, smmu);
+	if (ret) {
+		put_device(smmu);
+		return ret;
+	}
+	/* CX and the bus clocks are already held on by the coordinator. */
+	ret = pm_runtime_set_active(smmu);
+	if (ret)
+		return ret; /* Retain the attached device, as with other staged failures. */
+	pm_runtime_enable(smmu);
+	/* Keep the IORT supplier active throughout this initial bring-up. */
+	pm_runtime_get_noresume(smmu);
+	return 0;
+}
+
 static int prepare_domains(void)
 {
 	struct genpd_onecell_data *pd = platform_get_drvdata(cc.pdev);
@@ -185,7 +222,10 @@ static int prepare_domains(void)
 	smmu_bus = clk_get_sys(dev_name(gcc), "gcc_gpu_memnoc_gfx_clk");
 	if (IS_ERR(smmu_bus))
 		return PTR_ERR(smmu_bus);
-	return clk_prepare_enable(smmu_bus);
+	ret = clk_prepare_enable(smmu_bus);
+	if (ret)
+		return ret;
+	return attach_smmu_domain(pd->domains[CX_GDSC]);
 }
 
 static int gmu_dma_probe(struct platform_device *pdev)
