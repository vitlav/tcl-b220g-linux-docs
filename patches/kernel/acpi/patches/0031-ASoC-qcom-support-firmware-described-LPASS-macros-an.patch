 MODULE_DEVICE_TABLE(of, lpi_pinctrl_of_match);
 
+static const struct platform_device_id lpi_pinctrl_ids[] = {
+	{ "tcl-lpi-provider", (kernel_ulong_t)&sc7280_lpi_data },
