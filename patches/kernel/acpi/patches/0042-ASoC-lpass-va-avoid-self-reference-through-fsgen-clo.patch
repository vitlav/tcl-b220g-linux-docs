From 9e958581e9553507fb5997d0a5828f528677e225 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sun, 20 Sep 2026 19:57:32 +0300
Subject: [PATCH 2/2] ASoC: lpass-va: avoid self-reference through fsgen clock

VA registers fsgen as its own clock provider, then devm_clk_hw_get_clk() keeps a consumer reference to that provider for the complete device lifetime. The reference pins snd-soc-lpass-va-macro, so modprobe -r cannot reach the driver remove callback even after the ASoC card and dependent SoundWire devices are removed.

Acquire the fsgen consumer only for the DAPM PRE_PMU/POST_PMD event, release it with clk_put() after each operation, and propagate lookup failures. The clock remains enabled for the widget lifetime while the module no longer holds a permanent reference to itself.
---
 sound/soc/codecs/lpass-va-macro.c | 24 +++++++++++++-----------
 1 file changed, 13 insertions(+), 11 deletions(-)

diff --git a/sound/soc/codecs/lpass-va-macro.c b/sound/soc/codecs/lpass-va-macro.c
index 594951eb0..20d782ce9 100644
--- a/sound/soc/codecs/lpass-va-macro.c
+++ b/sound/soc/codecs/lpass-va-macro.c
@@ -218,7 +218,6 @@ struct va_macro {
 	struct clk *npl;
 	struct clk *macro;
 	struct clk *dcodec;
-	struct clk *fsgen;
 	struct clk_hw hw;
 	struct lpass_macro *pds;
 
@@ -517,15 +516,25 @@ static int va_macro_mclk_event(struct snd_soc_dapm_widget *w,
 {
 	struct snd_soc_component *comp = snd_soc_dapm_to_component(w->dapm);
 	struct va_macro *va = snd_soc_component_get_drvdata(comp);
+	struct clk *fsgen;
+	int ret = 0;
+
+	/* Avoid a permanent reference from this module to its own clock. */
+	fsgen = clk_hw_get_clk(&va->hw, "fsgen");
+	if (IS_ERR(fsgen))
+		return PTR_ERR(fsgen);
 
 	switch (event) {
 	case SND_SOC_DAPM_PRE_PMU:
-		return clk_prepare_enable(va->fsgen);
+		ret = clk_prepare_enable(fsgen);
+		break;
 	case SND_SOC_DAPM_POST_PMD:
-		clk_disable_unprepare(va->fsgen);
+		clk_disable_unprepare(fsgen);
+		break;
 	}
 
-	return 0;
+	clk_put(fsgen);
+	return ret;
 }
 
 static int va_macro_put_dec_enum(struct snd_kcontrol *kcontrol,
@@ -1704,13 +1713,6 @@ static int va_macro_probe(struct platform_device *pdev)
 		goto err_clkout;
 	}
 
-	va->fsgen = devm_clk_hw_get_clk(dev, &va->hw, "fsgen");
-	if (IS_ERR(va->fsgen)) {
-		ret = PTR_ERR(va->fsgen);
-		pm_runtime_disable(dev);
-		goto err_clkout;
-	}
-
 	return 0;
 
 err_clkout:
