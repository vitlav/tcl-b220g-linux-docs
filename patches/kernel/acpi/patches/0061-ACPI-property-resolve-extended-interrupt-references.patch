From 7e6dad51dfd9eac7fb32ceda6ed610b10e36119b Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sat, 19 Sep 2026 05:30:56 +0300
Subject: [PATCH 61/70] ACPI: property: resolve extended interrupt references

---
 drivers/acpi/property.c | 36 ++++++++++++++++++++++++++++++++++--
 1 file changed, 34 insertions(+), 2 deletions(-)

diff --git a/drivers/acpi/property.c b/drivers/acpi/property.c
index 8ee5a1f0e..23b794ec9 100644
--- a/drivers/acpi/property.c
+++ b/drivers/acpi/property.c
@@ -16,6 +16,7 @@
 #include <linux/acpi.h>
 #include <linux/device.h>
 #include <linux/export.h>
+#include <linux/irqdomain.h>
 
 #include "internal.h"
 
@@ -1725,14 +1726,45 @@ static int acpi_fwnode_graph_parse_endpoint(const struct fwnode_handle *fwnode,
 static int acpi_fwnode_irq_get(const struct fwnode_handle *fwnode,
 			       unsigned int index)
 {
+	struct fwnode_reference_args args;
+	struct irq_fwspec fwspec = {};
 	struct resource res;
+	unsigned int native_irqs;
 	int ret;
+	int i;
+
+	for (native_irqs = 0; native_irqs <= index; native_irqs++) {
+		ret = acpi_irq_get(ACPI_HANDLE_FWNODE(fwnode), native_irqs,
+				   &res);
+		if (ret)
+			break;
+		if (native_irqs == index)
+			return res.start;
+	}
 
-	ret = acpi_irq_get(ACPI_HANDLE_FWNODE(fwnode), index, &res);
+	ret = fwnode_property_get_reference_args(fwnode,
+						 "interrupts-extended",
+						 "#interrupt-cells", 0,
+						 index - native_irqs, &args);
 	if (ret)
 		return ret;
+	if (!args.nargs || args.nargs > ARRAY_SIZE(fwspec.param)) {
+		ret = -EINVAL;
+		goto put;
+	}
+
+	fwspec.fwnode = args.fwnode;
+	fwspec.param_count = args.nargs;
+	for (i = 0; i < args.nargs; i++)
+		fwspec.param[i] = args.args[i];
 
-	return res.start;
+	ret = irq_create_fwspec_mapping(&fwspec);
+	if (!ret)
+		ret = -EINVAL;
+
+put:
+	fwnode_handle_put(args.fwnode);
+	return ret;
 }
 
 #define DECLARE_ACPI_FWNODE_OPS(ops) \
