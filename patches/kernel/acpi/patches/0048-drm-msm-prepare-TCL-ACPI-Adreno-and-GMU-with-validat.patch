+
 static struct clk_regmap *tcl_display_gcc_clocks[] = {
 	&tcl_gpll0.clkr, &tcl_disp_gpll0.clkr, &tcl_disp_ahb.clkr,
 	&tcl_disp_xo.clkr, &gcc_disp_hf_axi_clk.clkr,
