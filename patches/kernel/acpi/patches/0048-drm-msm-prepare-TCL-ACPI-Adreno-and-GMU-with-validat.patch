diff --git a/drivers/clk/qcom/gdsc.c b/drivers/clk/qcom/gdsc.c
index 726513535c701e3baf4992f3f99e10700d3fbd59..fa732b1f204be0ce50697213d378e0f47f3c573f 100644
--- a/drivers/clk/qcom/gdsc.c
+++ b/drivers/clk/qcom/gdsc.c
@@ -594,14 +594,24 @@ int gdsc_register(struct gdsc_desc *desc,
 	struct gdsc **scs = desc->scs;
 	size_t num = desc->num;
 
-	/* Initial non-DT use is one standalone, supply-free display domain. */
-	if (desc->platform_single_domain) {
-		if (dev->of_node || num != 1 || !scs[0] || scs[0]->parent ||
-		    scs[0]->supply || desc->pd_list || dev->pm_domain)
+	/* Board glue attaches standalone domains explicitly, without an OF provider. */
+	if (desc->platform_domains) {
+		if (dev->of_node || !num || desc->pd_list || dev->pm_domain)
 			return -EINVAL;
-		scs[0]->regmap = regmap;
-		scs[0]->rcdev = rcdev;
-		return gdsc_init(scs[0]);
+		for (i = 0; i < num; i++)
+			if (!scs[i] || scs[i]->parent || scs[i]->supply || scs[i]->needs_icc)
+				return -EINVAL;
+		for (i = 0; i < num; i++) {
+			scs[i]->regmap = regmap;
+			scs[i]->rcdev = rcdev;
+			ret = gdsc_init(scs[i]);
+			if (ret) {
+				while (i--)
+					WARN_ON(pm_genpd_remove(&scs[i]->pd));
