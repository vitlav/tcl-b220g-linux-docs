+			}
+		}
+		return 0;
 	}
 
 	data = devm_kzalloc(dev, sizeof(*data), GFP_KERNEL);
@@ -681,8 +691,9 @@ void gdsc_unregister(struct gdsc_desc *desc)
 	struct device *dev = desc->dev;
 	size_t num = desc->num;
 
