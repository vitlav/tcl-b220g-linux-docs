From ab127fd3611d81ec3eeb223ced7e9cc14d882e84 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 14:39:01 +0300
Subject: [PATCH 30/58] drm/msm: acquire managed named interconnect paths for
 ACPI consumers

---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c |  6 ++-
 drivers/gpu/drm/msm/msm_drv.h           |  2 +
 drivers/gpu/drm/msm/msm_io_utils.c      | 59 +++++++++++++++++++++++++
 drivers/gpu/drm/msm/msm_mdss.c          | 10 +++--
 4 files changed, 72 insertions(+), 5 deletions(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index 8386b655b67c5e24caa559e38ac89bdda6b585be..c54aa7dcda97b01922bfd70f690a8592d406aed5 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -411,8 +411,7 @@ static int dpu_kms_parse_data_bus_icc_path(struct dpu_kms *dpu_kms)
 	struct icc_path *path1;
 	struct device *dpu_dev = &dpu_kms->pdev->dev;
 
-	path0 = msm_icc_get(dpu_dev, "mdp0-mem");
-	path1 = msm_icc_get(dpu_dev, "mdp1-mem");
+	path0 = msm_devm_icc_get(dpu_dev, "mdp0-mem", false);
 
 	if (IS_ERR_OR_NULL(path0))
 		return PTR_ERR_OR_ZERO(path0);
@@ -420,6 +419,9 @@ static int dpu_kms_parse_data_bus_icc_path(struct dpu_kms *dpu_kms)
 	dpu_kms->path[0] = path0;
 	dpu_kms->num_paths = 1;
 
+	path1 = msm_devm_icc_get(dpu_dev, "mdp1-mem", true);
+	if (!dpu_dev->of_node && IS_ERR(path1))
+		return PTR_ERR(path1);
 	if (!IS_ERR_OR_NULL(path1)) {
 		dpu_kms->path[1] = path1;
 		dpu_kms->num_paths++;
diff --git a/drivers/gpu/drm/msm/msm_drv.h b/drivers/gpu/drm/msm/msm_drv.h
index aeaaa942e45237552957dc5def8f209ef5fe2d40..340af1ce0f3eec590dc44cdcac5192e09c40293e 100644
--- a/drivers/gpu/drm/msm/msm_drv.h
+++ b/drivers/gpu/drm/msm/msm_drv.h
@@ -464,6 +464,8 @@ void __iomem *msm_ioremap_mdss(struct platform_device *mdss_pdev,
 			       const char *name);
 
 struct icc_path *msm_icc_get(struct device *dev, const char *name);
+struct icc_path *msm_devm_icc_get(struct device *dev, const char *name,
+			       bool optional);
 
 static inline void msm_rmw(void __iomem *addr, u32 mask, u32 or)
 {
diff --git a/drivers/gpu/drm/msm/msm_io_utils.c b/drivers/gpu/drm/msm/msm_io_utils.c
index a35aae240c132690415e90e1f4642faf9eb6072d..be1e2d7b5d3043adb508e81ae2a4c36529d96f9e 100644
--- a/drivers/gpu/drm/msm/msm_io_utils.c
+++ b/drivers/gpu/drm/msm/msm_io_utils.c
@@ -208,3 +208,62 @@ struct icc_path *msm_icc_get(struct device *dev, const char *name)
 	return of_icc_get(mdss_dev, name);
 
 }
+
+static void msm_icc_release(void *data)
+{
+	icc_put(data);
+}
+
+/*
+ * Board-created non-OF consumers explicitly opt in. Each named route is a
+ * pair of qualified ICC node names in qcom,icc-<name>; qcom,icc-tag supplies
+ * the voting buckets. A DPU child may use its MDSS parent's route properties,
+ * but owns its own request and devres lifetime.
+ */
+struct icc_path *msm_devm_icc_get(struct device *dev, const char *name,
+			       bool optional)
+{
+	struct device *routes = dev;
+	struct icc_path *path;
+	const char *ends[2];
+	char prop[64];
+	u32 tag;
+	int ret;
+
+	if (dev->of_node) {
+		path = msm_icc_get(dev, name);
+		goto manage;
+	}
+
+	if (!device_property_read_bool(routes, "qcom,tcl-acpi-display"))
+		return ERR_PTR(-ENODEV);
+	if (snprintf(prop, sizeof(prop), "qcom,icc-%s", name) >= sizeof(prop))
+		return ERR_PTR(-EINVAL);
+	if (!device_property_present(routes, prop) && routes->parent &&
+	    device_property_read_bool(routes->parent, "qcom,tcl-acpi-display"))
+		routes = routes->parent;
+	if (!device_property_present(routes, prop))
+		return optional ? NULL : ERR_PTR(-ENOENT);
+
+	ret = device_property_string_array_count(routes, prop);
+	if (ret != ARRAY_SIZE(ends))
+		return ERR_PTR(ret < 0 ? ret : -EINVAL);
+	ret = device_property_read_string_array(routes, prop, ends, ARRAY_SIZE(ends));
+	if (ret != ARRAY_SIZE(ends))
+		return ERR_PTR(ret < 0 ? ret : -EINVAL);
+	ret = device_property_read_u32(routes, "qcom,icc-tag", &tag);
+	if (ret)
+		return ERR_PTR(ret);
+	if (!tag)
+		return ERR_PTR(-EINVAL);
+	path = icc_get(dev, ends[0], ends[1]);
+	if (!path)
+		return ERR_PTR(-ENODEV);
+	if (!IS_ERR(path))
+		icc_set_tag(path, tag);
+manage:
+	if (IS_ERR_OR_NULL(path))
+		return path;
+	ret = devm_add_action_or_reset(dev, msm_icc_release, path);
+	return ret ? ERR_PTR(ret) : path;
+}
diff --git a/drivers/gpu/drm/msm/msm_mdss.c b/drivers/gpu/drm/msm/msm_mdss.c
index 9820b57df3921d40d6522ae0d5937241c136db2c..1df369a3960bde1f82eafb079e0fa19023cc3072 100644
--- a/drivers/gpu/drm/msm/msm_mdss.c
+++ b/drivers/gpu/drm/msm/msm_mdss.c
@@ -53,20 +53,24 @@ static int msm_mdss_parse_data_bus_icc_path(struct device *dev,
 	struct icc_path *path1;
 	struct icc_path *reg_bus_path;
 
-	path0 = devm_of_icc_get(dev, "mdp0-mem");
+	path0 = msm_devm_icc_get(dev, "mdp0-mem", false);
 	if (IS_ERR_OR_NULL(path0))
 		return PTR_ERR_OR_ZERO(path0);
 
 	msm_mdss->mdp_path[0] = path0;
 	msm_mdss->num_mdp_paths = 1;
 
-	path1 = devm_of_icc_get(dev, "mdp1-mem");
+	path1 = msm_devm_icc_get(dev, "mdp1-mem", true);
+	if (!dev->of_node && IS_ERR(path1))
+		return PTR_ERR(path1);
 	if (!IS_ERR_OR_NULL(path1)) {
 		msm_mdss->mdp_path[1] = path1;
 		msm_mdss->num_mdp_paths++;
 	}
 
-	reg_bus_path = of_icc_get(dev, "cpu-cfg");
+	reg_bus_path = msm_devm_icc_get(dev, "cpu-cfg", false);
+	if (!dev->of_node && IS_ERR(reg_bus_path))
+		return PTR_ERR(reg_bus_path);
 	if (!IS_ERR_OR_NULL(reg_bus_path))
 		msm_mdss->reg_bus_path = reg_bus_path;
 
