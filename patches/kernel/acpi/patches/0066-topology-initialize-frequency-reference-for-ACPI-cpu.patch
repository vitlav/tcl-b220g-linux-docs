From 25695a8c41d1a08c322245ee61c46531f51e41f1 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sat, 19 Sep 2026 21:25:54 +0300
Subject: [PATCH 66/70] topology: initialize frequency reference for ACPI
 cpufreq

ACPI systems currently skip the cpufreq policy notifier because CPPC normally supplies the CPU capacity frequency reference. That assumption leaves capacity_freq_ref at zero on ACPI machines without _CPC that use a regular cpufreq driver. The first frequency transition then triggers topology_set_freq_scale() with a zero maximum frequency.

Skip the notifier only when ACPI actually exposes valid CPC data. ACPI systems without CPPC now initialize their frequency reference from CPUFreq policies, matching the existing Device Tree path.
---
 drivers/base/arch_topology.c | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/drivers/base/arch_topology.c b/drivers/base/arch_topology.c
index 8c5e47c28..21e448573 100644
--- a/drivers/base/arch_topology.c
+++ b/drivers/base/arch_topology.c
@@ -23,6 +23,8 @@
 #include <linux/sched.h>
 #include <linux/units.h>
 
+#include <acpi/cppc_acpi.h>
+
 #define CREATE_TRACE_POINTS
 #include <trace/events/hw_pressure.h>
 
@@ -431,10 +433,11 @@ static int __init register_cpufreq_notifier(void)
 	int ret;
 
 	/*
-	 * On ACPI-based systems skip registering cpufreq notifier as cpufreq
-	 * information is not needed for cpu capacity initialization.
+	 * ACPI systems with valid CPPC data initialize the frequency reference
+	 * from _CPC.  Other ACPI systems may still use a regular cpufreq driver
+	 * and need the policy notifier just like Device Tree systems do.
 	 */
-	if (!acpi_disabled)
+	if (!acpi_disabled && acpi_cpc_valid())
 		return -EINVAL;
 
 	if (!alloc_cpumask_var(&cpus_to_visit, GFP_KERNEL))
