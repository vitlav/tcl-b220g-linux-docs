 sound/soc/qcom/qdsp6/q6adm.c              |  3 +-
 sound/soc/qcom/qdsp6/q6afe-clocks.c       |  7 +++
 sound/soc/qcom/qdsp6/q6afe.c              | 75 ++++++++++++++++++++++-
 sound/soc/qcom/qdsp6/q6asm-dai.c          | 62 +++++++++++++------
 sound/soc/qcom/qdsp6/q6asm.c              | 38 +++++++++++-
 sound/soc/qcom/qdsp6/q6dsp-lpass-clocks.c | 75 +++++++++++++++++++++--
 6 files changed, 235 insertions(+), 25 deletions(-)

