 drivers/gpu/drm/msm/adreno/a6xx_gpu.c      |  11 ++-
 drivers/gpu/drm/msm/adreno/adreno_device.c |  29 +++++-
 drivers/gpu/drm/msm/adreno/adreno_gpu.c    |  35 +++++--
 drivers/gpu/drm/msm/adreno/tcl_acpi.h      |  40 ++++++++
 5 files changed, 188 insertions(+), 36 deletions(-)
 create mode 100644 drivers/gpu/drm/msm/adreno/tcl_acpi.h

