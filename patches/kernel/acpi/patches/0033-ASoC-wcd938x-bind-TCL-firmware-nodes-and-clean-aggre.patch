 		if (IS_ERR(wcd938x->us_euro_mux)) {
 			ret = PTR_ERR(wcd938x->us_euro_mux);
@@ -3230,14 +3288,18 @@ static int wcd938x_populate_dt_data(struct wcd938x_priv *wcd938x, struct device
 
 	cfg->swap_gnd_mic = wcd938x_swap_gnd_mic;
 
