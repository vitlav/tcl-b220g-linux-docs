@@ -3255,6 +3317,9 @@ static int wcd938x_populate_dt_data(struct wcd938x_priv *wcd938x, struct device
 
 static int wcd938x_reset(struct wcd938x_priv *wcd938x)
 {
+	if (!wcd938x->reset_gpio)
+		return 0;
