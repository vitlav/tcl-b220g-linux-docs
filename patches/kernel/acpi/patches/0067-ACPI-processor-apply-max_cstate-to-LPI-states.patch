From 7150c99f7afa8428cec7ae4d91c8fbbefc131cc3 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sat, 19 Sep 2026 22:28:52 +0300
Subject: [PATCH 67/70] ACPI: processor: apply max_cstate to LPI states

---
 drivers/acpi/processor_idle.c | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/acpi/processor_idle.c b/drivers/acpi/processor_idle.c
index 4482cf28f..a615e3364 100644
--- a/drivers/acpi/processor_idle.c
+++ b/drivers/acpi/processor_idle.c
@@ -1184,7 +1184,11 @@ static void acpi_processor_setup_lpi_states(struct acpi_processor *pr)
 	if (!pr->flags.has_lpi)
 		return;
 
-	for (i = 0; i < pr->power.count && i < CPUIDLE_STATE_MAX; i++) {
+	if (max_cstate == 0)
+		max_cstate = 1;
+
+	for (i = 0; i < pr->power.count && i < CPUIDLE_STATE_MAX &&
+	     i <= max_cstate; i++) {
 		lpi = &pr->power.lpi_states[i];
 
 		state = &drv->states[i];
