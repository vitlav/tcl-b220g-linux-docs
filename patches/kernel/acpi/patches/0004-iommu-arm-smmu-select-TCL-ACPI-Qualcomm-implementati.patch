From b95194cec85034bc7346544379091791ab9ede7c Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 11:41:38 +0300
Subject: [PATCH 04/58] iommu: arm-smmu: select TCL ACPI Qualcomm
 implementations

The generic IORT description does not carry the OF compatible strings
used to choose Qualcomm SMMU implementations. The Apps MMU500 and Adreno
SMMUv2 nevertheless require different Qualcomm handling.

Recognize the QCOMEDK2 SC7180 IORT revision and distinguish the Apps
controller at 0x15000000/0x100000 from the GPU controller at
0x05040000/0x10000 using model and resource checks. Select the
corresponding implementation only for these matches. This supplies
implementation selection, not the DMA stream mappings or power-domain
wiring needed by consumers.
---
 drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c | 30 ++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
index e2c914fccd6fcac770b414de7b9ae3e8532f8711..4ba940559a806d1893343f9d34d823bc7ebc4c1c 100644
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -769,6 +769,33 @@ static const struct of_device_id __maybe_unused qcom_smmu_impl_of_match[] = {
 };
 
 #ifdef CONFIG_ACPI
+/* ACPI has no OF adreno-smmu compatible: select the GPU implementation directly. */
+static const struct qcom_smmu_match_data sc7180_acpi_adreno_data = {
+	.impl = &qcom_adreno_smmu_v2_impl,
+};
+
+static struct acpi_platform_list sc7180_acpi_platlist[] = {
+	{ "QCOM  ", "QCOMEDK2", 0x7180, ACPI_SIG_IORT, equal, "SC7180 SMMU" },
+	{ }
+};
+
+static struct arm_smmu_device *sc7180_acpi_smmu_create(struct arm_smmu_device *smmu)
+{
+	/* numpage still holds the MMIO resource size at implementation selection. */
+	if (smmu->version == ARM_SMMU_V2 &&
+	    smmu->model == ARM_MMU500 && smmu->ioaddr == 0x15000000 &&
+	    smmu->numpage == 0x100000)
+		return qcom_smmu_create(smmu, &qcom_smmu_500_impl0_data);
+
+	if (smmu->version == ARM_SMMU_V2 &&
+	    smmu->model == GENERIC_SMMU && smmu->ioaddr == 0x05040000 &&
+	    smmu->numpage == 0x10000)
+		return qcom_smmu_create(smmu, &sc7180_acpi_adreno_data);
+
+	return ERR_PTR(dev_err_probe(smmu->dev, -ENODEV,
+				     "Unsupported SC7180 ACPI SMMU resource/model\n"));
+}
+
 static struct acpi_platform_list qcom_acpi_platlist[] = {
 	{ "LENOVO", "CB-01   ", 0x8180, ACPI_SIG_IORT, equal, "QCOM SMMU" },
 	{ "QCOM  ", "QCOMEDK2", 0x8180, ACPI_SIG_IORT, equal, "QCOM SMMU" },
@@ -816,6 +843,9 @@ struct arm_smmu_device *qcom_smmu_impl_init(struct arm_smmu_device *smmu)
 
 #ifdef CONFIG_ACPI
 	if (np == NULL) {
+		if (acpi_match_platform_list(sc7180_acpi_platlist) >= 0)
+			return sc7180_acpi_smmu_create(smmu);
+
 		/* Match platform for ACPI boot */
 		if (acpi_match_platform_list(qcom_acpi_platlist) >= 0)
 			return qcom_smmu_create(smmu, &qcom_smmu_500_impl0_data);
