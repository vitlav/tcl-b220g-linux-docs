From ed4264a167ed9dbe5ae1e2362b5897818661bb8d Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 15:16:52 +0300
Subject: [PATCH 37/58] drm/msm/dsi: check initial power errors and add ACPI
 byte OPPs

DSI configuration detection accesses hardware after acquiring clocks and
runtime power, but must not continue when either acquisition fails. The
ACPI host also lacks the byte-clock OPP table normally supplied by DT.

Return clock/runtime-PM errors from initial configuration detection and
initialize host mutexes before later cleanup can use them. Add dynamic
byte-clock OPPs at 187.5, 300 and 358 MHz with performance levels 64,
128 and 192, and remove them on unwind. These levels are power-domain
states, not voltages. Keep optional OF OPP-table handling for existing
DT platforms.
---
 drivers/gpu/drm/msm/dsi/dsi_host.c | 67 ++++++++++++++++++++++++------
 1 file changed, 55 insertions(+), 12 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 8eed25bdf97126e782c14c31559af55a0121a0f7..9d816bdee1d13423ae834d96542da2ebaaa06b1e 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -212,10 +212,12 @@ dsi_get_config(struct msm_dsi_host *msm_host)
 	if (IS_ERR(ahb_clk)) {
 		dev_err_probe(dev, PTR_ERR(ahb_clk), "%s: cannot get interface clock\n",
 			      __func__);
-		goto exit;
+		return ERR_CAST(ahb_clk);
 	}
 
-	pm_runtime_get_sync(dev);
+	ret = pm_runtime_resume_and_get(dev);
+	if (ret < 0)
+		return ERR_PTR(ret);
 
 	ret = clk_prepare_enable(ahb_clk);
 	if (ret) {
@@ -230,6 +232,8 @@ dsi_get_config(struct msm_dsi_host *msm_host)
 	}
 
 	cfg_hnd = msm_dsi_cfg_get(major, minor);
+	if (!cfg_hnd)
+		ret = -EINVAL;
 
 	DBG("%s: Version %x:%x\n", __func__, major, minor);
 
@@ -237,8 +241,7 @@ dsi_get_config(struct msm_dsi_host *msm_host)
 	clk_disable_unprepare(ahb_clk);
 runtime_put:
 	pm_runtime_put_sync(dev);
-exit:
-	return cfg_hnd;
+	return ret ? ERR_PTR(ret) : cfg_hnd;
 }
 
 static inline struct msm_dsi_host *to_msm_dsi_host(struct mipi_dsi_host *host)
@@ -1992,6 +1995,37 @@ static int dsi_host_get_id(struct msm_dsi_host *msm_host)
 	return -EINVAL;
 }
 
+static void tcl_dsi_remove_opps(void *data)
+{
+	dev_pm_opp_remove_all_dynamic(data);
+}
+
+static int tcl_dsi_add_opps(struct device *dev)
+{
+	/* SC7180 DSI byte-clock OPPs; levels are not uV. */
+	struct dev_pm_opp_data opps[] = {
+		{ .freq = 187500000, .level = 64 },
+		{ .freq = 300000000, .level = 128 },
+		{ .freq = 358000000, .level = 192 },
+	};
+	unsigned int i;
+	int ret;
+
+	ret = dev_pm_opp_get_opp_count(dev);
+	if (ret > 0)
+		return -EEXIST;
+	if (ret < 0 && ret != -ENODEV)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(opps); i++) {
+		ret = dev_pm_opp_add_dynamic(dev, &opps[i]);
+		if (ret) {
+			tcl_dsi_remove_opps(dev);
+			return ret;
+		}
+	}
+	return devm_add_action_or_reset(dev, tcl_dsi_remove_opps, dev);
+}
+
 int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 {
 	struct msm_dsi_host *msm_host = NULL;
@@ -2003,6 +2037,8 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	if (!msm_host)
 		return -ENOMEM;
 
+	mutex_init(&msm_host->dev_mutex);
+	mutex_init(&msm_host->cmd_mutex);
 	msm_host->pdev = pdev;
 	msm_dsi->host = &msm_host->base;
 
@@ -2019,9 +2055,12 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	pm_runtime_enable(&pdev->dev);
 
 	msm_host->cfg_hnd = dsi_get_config(msm_host);
-	if (!msm_host->cfg_hnd)
-		return dev_err_probe(&pdev->dev, -EINVAL,
+	if (IS_ERR(msm_host->cfg_hnd)) {
+		ret = PTR_ERR(msm_host->cfg_hnd);
+		msm_host->cfg_hnd = NULL;
+		return dev_err_probe(&pdev->dev, ret,
 				     "%s: get config failed\n", __func__);
+	}
 	cfg = msm_host->cfg_hnd->cfg;
 
 	msm_host->id = dsi_host_get_id(msm_host);
@@ -2051,10 +2090,16 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	ret = devm_pm_opp_set_clkname(&pdev->dev, "byte");
 	if (ret)
 		return ret;
-	/* OPP table is optional */
-	ret = devm_pm_opp_of_add_table(&pdev->dev);
-	if (ret && ret != -ENODEV)
-		return dev_err_probe(&pdev->dev, ret, "invalid OPP table in device tree\n");
+	if (pdev->dev.of_node) {
+		/* OPP table is optional for existing DT platforms. */
+		ret = devm_pm_opp_of_add_table(&pdev->dev);
+		if (ret && ret != -ENODEV)
+			return dev_err_probe(&pdev->dev, ret, "invalid OPP table in device tree\n");
+	} else {
+		ret = tcl_dsi_add_opps(&pdev->dev);
+		if (ret)
+			return dev_err_probe(&pdev->dev, ret, "failed to add DSI byte OPPs\n");
+	}
 
 	ret = platform_get_irq(pdev, 0);
 	if (ret < 0)
@@ -2071,8 +2116,6 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 
 	init_completion(&msm_host->dma_comp);
 	init_completion(&msm_host->video_comp);
-	mutex_init(&msm_host->dev_mutex);
-	mutex_init(&msm_host->cmd_mutex);
 	spin_lock_init(&msm_host->intr_lock);
 
 	/* setup workqueue */
