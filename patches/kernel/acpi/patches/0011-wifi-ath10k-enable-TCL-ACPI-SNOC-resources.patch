From 6ed032e7746d44949b2af98ef960b74749d79854 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 11:43:41 +0300
Subject: [PATCH 11/58] wifi: ath10k: enable TCL ACPI SNOC resources

ath10k SNOC must bind to the board-created WCN3990 device and obtain MSA
memory and firmware quirks without an OF node. Starting it without both
WLAN DMA streams would leave an incomplete DMA configuration.

Add the tcl-wcn3990 platform ID, read firmware/quirk properties through
the device-property API, and accept a named msa memory resource after
checking its size. Require SIDs 0xc0 and 0xc1 plus an attached IOMMU
domain on the non-OF path. This connects the ACPI resource description
to ath10k; firmware services, authentication and IP configuration remain
separate requirements.
---
 drivers/net/wireless/ath/ath10k/qmi.c  |  5 ++--
 drivers/net/wireless/ath/ath10k/snoc.c | 36 +++++++++++++++++++++++---
 2 files changed, 35 insertions(+), 6 deletions(-)

diff --git a/drivers/net/wireless/ath/ath10k/qmi.c b/drivers/net/wireless/ath/ath10k/qmi.c
index 0d74548a5f349a045ac0401ce419deeee77b9aa9..02088be9707db19e1a80acfb0467859422a5d379 100644
--- a/drivers/net/wireless/ath/ath10k/qmi.c
+++ b/drivers/net/wireless/ath/ath10k/qmi.c
@@ -4,6 +4,7 @@
  * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
  */
 
+#include <linux/property.h>
 #include <linux/completion.h>
 #include <linux/device.h>
 #include <linux/debugfs.h>
@@ -1089,10 +1090,10 @@ int ath10k_qmi_init(struct ath10k *ar, u32 msa_size)
 	qmi->ar = ar;
 	ar_snoc->qmi = qmi;
 
-	if (of_property_read_bool(dev->of_node, "qcom,msa-fixed-perm"))
+	if (device_property_read_bool(dev, "qcom,msa-fixed-perm"))
 		qmi->msa_fixed_perm = true;
 
-	if (of_property_read_bool(dev->of_node, "qcom,no-msa-ready-indicator"))
+	if (device_property_read_bool(dev, "qcom,no-msa-ready-indicator"))
 		qmi->no_msa_ready_indicator = true;
 
 	ret = qmi_handle_init(&qmi->qmi_hdl,
diff --git a/drivers/net/wireless/ath/ath10k/snoc.c b/drivers/net/wireless/ath/ath10k/snoc.c
index 3106502275781d32d17a45a661362206144df6b3..4e54430f4bc5378610c57ed48f663072bb25c5d7 100644
--- a/drivers/net/wireless/ath/ath10k/snoc.c
+++ b/drivers/net/wireless/ath/ath10k/snoc.c
@@ -1358,9 +1358,9 @@ static void ath10k_snoc_quirks_init(struct ath10k *ar)
 	struct device *dev = &ar_snoc->dev->dev;
 
 	/* ignore errors, keep NULL if there is no property */
-	of_property_read_string(dev->of_node, "firmware-name", &ar->board_name);
+	device_property_read_string(dev, "firmware-name", &ar->board_name);
 
-	if (of_property_read_bool(dev->of_node, "qcom,snoc-host-cap-8bit-quirk"))
+	if (device_property_read_bool(dev, "qcom,snoc-host-cap-8bit-quirk"))
 		set_bit(ATH10K_SNOC_FLAG_8BIT_HOST_CAP_QUIRK, &ar_snoc->flags);
 
 	if (of_property_read_bool(dev->of_node, "qcom,snoc-host-cap-skip-quirk"))
@@ -1578,10 +1578,19 @@ static void ath10k_modem_deinit(struct ath10k *ar)
 static int ath10k_setup_msa_resources(struct ath10k *ar, u32 msa_size)
 {
 	struct device *dev = ar->dev;
-	struct resource r;
+	struct resource r, *res;
 	int ret;
 
-	ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &r);
+	if (dev->of_node) {
+		ret = of_reserved_mem_region_to_resource(dev->of_node, 0, &r);
+	} else {
+		res = platform_get_resource_byname(to_platform_device(dev),
+						   IORESOURCE_MEM, "msa");
+		if (!res || resource_size(res) < msa_size)
+			return -EINVAL;
+		r = *res;
+		ret = 0;
+	}
 	if (!ret) {
 		ar->msa.paddr = r.start;
 		ar->msa.mem_size = resource_size(&r);
@@ -1736,11 +1745,23 @@ static int ath10k_snoc_probe(struct platform_device *pdev)
 
 	dev = &pdev->dev;
 	drv_data = device_get_match_data(dev);
+	if (!drv_data && platform_get_device_id(pdev))
+		drv_data = (const void *)platform_get_device_id(pdev)->driver_data;
 	if (!drv_data) {
 		dev_err(dev, "failed to find matching device tree id\n");
 		return -EINVAL;
 	}
 
+	if (!dev->of_node) {
+		struct iommu_fwspec *fwspec = dev_iommu_fwspec_get(dev);
+
+		if (!fwspec || fwspec->num_ids != 2 ||
+		    fwspec->ids[0] != 0xc0 || fwspec->ids[1] != 0xc1 ||
+		    !iommu_get_domain_for_dev(dev))
+			return dev_err_probe(dev, -ENODEV,
+					     "TCL WLAN requires both IORT stream IDs and a DMA domain\n");
+	}
+
 	ret = dma_set_mask_and_coherent(dev, drv_data->dma_mask);
 	if (ret) {
 		dev_err(dev, "failed to set dma mask: %d\n", ret);
@@ -1929,7 +1950,14 @@ static void ath10k_snoc_shutdown(struct platform_device *pdev)
 	ath10k_snoc_free_resources(ar);
 }
 
+static const struct platform_device_id ath10k_snoc_platform_ids[] = {
+	{ "tcl-wcn3990", (kernel_ulong_t)&drv_priv },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, ath10k_snoc_platform_ids);
+
 static struct platform_driver ath10k_snoc_driver = {
+	.id_table = ath10k_snoc_platform_ids,
 	.probe = ath10k_snoc_probe,
 	.remove = ath10k_snoc_remove,
 	.shutdown = ath10k_snoc_shutdown,
