From 50a70a449bcf279bee5cdc49c62f32e0230c4f49 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 17:37:54 +0300
Subject: [PATCH 41/58] soc: qcom: validate TCL display parent names and domain
 array

Several display and fabric admission checks compare a parent device name
before checking that it exists. The coordinator also passes a domain
array whose size must match the actual array object.

Add parent-name guards in DPU, DSI, BCM-voter and SC7180 fabric
matching. Correct the coordinator's domain-array size expression so
dependency setup covers the intended array. These checks tighten
existing board paths; they do not add new supported devices or remove
the requirement to validate resources and suppliers.
---
 drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c | 1 +
 drivers/gpu/drm/msm/dsi/dsi.c           | 1 +
 drivers/interconnect/qcom/bcm-voter.c   | 1 +
 drivers/interconnect/qcom/sc7180.c      | 1 +
 drivers/soc/qcom/tcl_acpi_display.c     | 2 +-
 5 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
index 01a797cfe389c5dee73628ccc2b451401f3b9e1b..f505816c2a65d57e0bd08a57dfbeea74cc86a369 100644
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_kms.c
@@ -1399,6 +1399,7 @@ static int tcl_dpu_check_resources(struct platform_device *pdev)
 	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
 	    !device_property_read_bool(dev, "qcom,tcl-acpi-display") ||
 	    !device_property_read_bool(dev->parent, "qcom,tcl-acpi-display") ||
+	    !dev_name(dev->parent) ||
 	    strcmp(dev_name(dev->parent), "tcl-sc7180-mdss") ||
 	    ACPI_FAILURE(acpi_get_handle(NULL, "\\_SB.GPU0", &gpu)) ||
 	    ACPI_HANDLE(dev->parent->parent) != gpu ||
diff --git a/drivers/gpu/drm/msm/dsi/dsi.c b/drivers/gpu/drm/msm/dsi/dsi.c
index 31729fbab6dcd4a18e3ed2ce3ca433f186ca1b42..768bced4475b60cc1f8e5350bcecaf23887fc0fc 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.c
+++ b/drivers/gpu/drm/msm/dsi/dsi.c
@@ -224,6 +224,7 @@ static int tcl_dsi_check_resources(struct platform_device *pdev)
 	    !dmi_match(DMI_SYS_VENDOR, "TCL Communication Ltd.") ||
 	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
 	    !device_property_read_bool(dev, "qcom,tcl-acpi-display") ||
+	    !dev_name(dev->parent) ||
 	    strcmp(dev_name(dev->parent), "tcl-sc7180-mdss") ||
 	    ACPI_FAILURE(acpi_get_handle(NULL, "\\_SB.GPU0", &gpu)) ||
 	    ACPI_HANDLE(dev->parent->parent) != gpu)
diff --git a/drivers/interconnect/qcom/bcm-voter.c b/drivers/interconnect/qcom/bcm-voter.c
index c0fc54fb3e414e3d2d405a5d0e35d0bf807a2114..720f4eeae1769a611ec76e068710b39c5384f90b 100644
--- a/drivers/interconnect/qcom/bcm-voter.c
+++ b/drivers/interconnect/qcom/bcm-voter.c
@@ -422,6 +422,7 @@ static int qcom_icc_bcm_voter_probe(struct platform_device *pdev)
 	if (!np && (acpi_disabled || !pdev->dev.parent ||
 	    !dmi_match(DMI_SYS_VENDOR, "TCL Communication Ltd.") ||
 	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
+	    !dev_name(pdev->dev.parent) ||
 	    strcmp(dev_name(pdev->dev.parent), "rpmh") ||
 	    !device_property_read_bool(&pdev->dev, "qcom,tcl-acpi-display")))
 		return -ENODEV;
diff --git a/drivers/interconnect/qcom/sc7180.c b/drivers/interconnect/qcom/sc7180.c
index 05a9ac2b8ae5349755b906038089f60a88b05663..93035d2eb4fa22c0a2840412e718356c7a720481 100644
--- a/drivers/interconnect/qcom/sc7180.c
+++ b/drivers/interconnect/qcom/sc7180.c
@@ -1808,6 +1808,7 @@ static int sc7180_noc_probe(struct platform_device *pdev)
 	if (!pdev->dev.of_node && (acpi_disabled || !pdev->dev.parent ||
 	    !dmi_match(DMI_SYS_VENDOR, "TCL Communication Ltd.") ||
 	    !dmi_match(DMI_PRODUCT_NAME, "B220G") ||
+	    !dev_name(pdev->dev.parent) ||
 	    strcmp(dev_name(pdev->dev.parent), "rpmh") ||
 	    !device_property_read_bool(&pdev->dev, "qcom,tcl-acpi-display")))
 		return -ENODEV;
diff --git a/drivers/soc/qcom/tcl_acpi_display.c b/drivers/soc/qcom/tcl_acpi_display.c
index 353dd95f18380bf82edcdda9ece6519cdc42d827..3d3472c563f743250b7617e38267531d08cb5dbc 100644
--- a/drivers/soc/qcom/tcl_acpi_display.c
+++ b/drivers/soc/qcom/tcl_acpi_display.c
@@ -807,7 +807,7 @@ static int __init tcl_display_init(void)
 		goto put_pd;
 	}
 	domains = dev_get_drvdata(rpmhpd);
-	if (!domains || domains->num_domains <= SC7180_CX ||
+	if (!domains || !domains->domains || domains->num_domains <= SC7180_CX ||
 	    !domains->domains[SC7180_CX]) {
 		ret = -ENODEV;
 		goto put_pd;
