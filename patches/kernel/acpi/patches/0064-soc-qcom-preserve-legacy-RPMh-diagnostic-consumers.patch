From a6a1d796c155c9aec5dc041f31dfbafe1748a8e0 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Sat, 19 Sep 2026 17:59:56 +0300
Subject: [PATCH 64/70] soc: qcom: preserve legacy RPMh diagnostic consumers

Use generic fwnode providers when firmware nodes are present, while retaining the former clkdev and explicit genpd behavior for platform devices without firmware nodes. This keeps the TCL legacy diagnostic fallback operational without changing the standard ACPI provider path.
---
 drivers/clk/qcom/clk-rpmh.c    | 11 ++++++++++-
 drivers/pmdomain/qcom/rpmhpd.c |  6 ++++--
 2 files changed, 14 insertions(+), 3 deletions(-)

diff --git a/drivers/clk/qcom/clk-rpmh.c b/drivers/clk/qcom/clk-rpmh.c
index f6bdf61d5..d2b4bc1a1 100644
--- a/drivers/clk/qcom/clk-rpmh.c
+++ b/drivers/clk/qcom/clk-rpmh.c
@@ -4,6 +4,7 @@
  */
 
 #include <linux/clk-provider.h>
+#include <linux/clkdev.h>
 #include <linux/property.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
@@ -1108,12 +1109,20 @@ static int clk_rpmh_probe(struct platform_device *pdev)
 			dev_err(&pdev->dev, "failed to register %s\n", name);
 			return ret;
 		}
+		if (!pdev->dev.of_node && !dev_fwnode(&pdev->dev)) {
+			ret = devm_clk_hw_register_clkdev(&pdev->dev, hw_clks[i],
+							  name, dev_name(&pdev->dev));
+			if (ret)
+				return ret;
+		}
 	}
 
-	if (!pdev->dev.of_node)
+	if (!pdev->dev.of_node && dev_fwnode(&pdev->dev))
 		return devm_fwnode_clk_add_hw_provider(&pdev->dev,
 							 &fwnode_clk_rpmh_ops,
 							 (void *)desc);
+	if (!pdev->dev.of_node)
+		return 0;
 
 	/* typecast to silence compiler warning */
 	ret = devm_of_clk_add_hw_provider(&pdev->dev, of_clk_rpmh_hw_get,
diff --git a/drivers/pmdomain/qcom/rpmhpd.c b/drivers/pmdomain/qcom/rpmhpd.c
index d6d105834..7f9b51317 100644
--- a/drivers/pmdomain/qcom/rpmhpd.c
+++ b/drivers/pmdomain/qcom/rpmhpd.c
@@ -1191,8 +1191,10 @@ static int rpmhpd_probe(struct platform_device *pdev)
 	}
 
 	platform_set_drvdata(pdev, data);
-	if (!pdev->dev.of_node)
+	if (!pdev->dev.of_node && dev_fwnode(dev))
 		return fwnode_genpd_add_provider_onecell(dev_fwnode(dev), data);
+	if (!pdev->dev.of_node)
+		return 0;
 
 	return of_genpd_add_provider_onecell(pdev->dev.of_node, data);
 }
@@ -1206,7 +1208,7 @@ static void rpmhpd_sync_state(struct device *dev)
 	unsigned int i;
 	int ret;
 
-	if (!desc)
+	if (!desc || (!dev->of_node && !dev_fwnode(dev)))
 		return;
 	rpmhpds = desc->rpmhpds;
 	if (dev->of_node)
