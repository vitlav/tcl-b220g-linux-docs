From 38efc5e74e397c67794ed6bbba9b482046ac9b36 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 15:07:22 +0300
Subject: [PATCH 35/58] soc: qcom: stage TCL DPU resources and preserve display
 properties

The coordinator must create the DPU child beneath MDSS with its own
register windows, interrupt and clock properties. Replacing its software
node with composite GPU0 attributes loses the description needed by the
display drivers.

Stage the mdp window at 0xae01000 and vbif at 0xaeb0000, obtain the
child interrupt from the MDSS IRQ domain, and attach the clock/power
suppliers. Keep probe blocked until the DSI component graph is complete.
Route DPU IORT setup through its dedicated stream selection without
importing composite PASID/stall properties or discarding the software
node.
---
 drivers/acpi/arm64/iort.c           |  8 +--
 drivers/soc/qcom/tcl_acpi_display.c | 87 ++++++++++++++++++++++++++++-
 2 files changed, 88 insertions(+), 7 deletions(-)

diff --git a/drivers/acpi/arm64/iort.c b/drivers/acpi/arm64/iort.c
index 2da96a56a4dcfac4cd2954b35848b173fb54b62b..fef144737e460833e313e6d6f8329e5693b1e823 100644
--- a/drivers/acpi/arm64/iort.c
+++ b/drivers/acpi/arm64/iort.c
@@ -1685,10 +1685,10 @@ int iort_iommu_configure_id(struct device *dev, const u32 *id_in)
 
 		if (!dev->of_node && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
 		    device_property_read_bool(dev, "qcom,tcl-acpi-display")) {
-			err = id_in ? -EINVAL : iort_tcl_dpu_map(dev, node);
-			if (!err)
-				iort_named_component_init(dev, node);
-			return err;
+			/* GPU0 PASID/stall flags describe a composite device, not
+			 * this display engine. Keep the board's software node.
+			 */
+			return id_in ? -EINVAL : iort_tcl_dpu_map(dev, node);
 		}
 
 		if (!id_in && iort_tcl_urs_input_id(dev, node, &tcl_input)) {
diff --git a/drivers/soc/qcom/tcl_acpi_display.c b/drivers/soc/qcom/tcl_acpi_display.c
index fdc824d1a2217237886df24ec5f26bb7ca736004..cc617c26b975e71d005dad4e8fd5c1d9ae13ceef 100644
--- a/drivers/soc/qcom/tcl_acpi_display.c
+++ b/drivers/soc/qcom/tcl_acpi_display.c
@@ -3,6 +3,7 @@
 #include <linux/acpi.h>
 #include <linux/dmi.h>
 #include <linux/irq.h>
+#include <linux/irqdomain.h>
 #include <linux/module.h>
 #include <linux/interconnect.h>
 #include <linux/resource.h>
@@ -17,7 +18,8 @@
  * Do not manually unbind its suppliers. No DPU/DSI host or scanout is enabled here.
  * A coherent kernel containing the clock-core changes is required.
  */
-static struct tcl_display_stage gcc, dispcc, phy_reg, phy, mdss;
+static struct tcl_display_stage gcc, dispcc, phy_reg, phy, mdss, dpu;
+static unsigned int dpu_irq;
 static int mdss_irq;
 static struct tcl_display_stage bcm, noc[5];
 static struct icc_path *display_mem, *display_cfg;
@@ -41,6 +43,11 @@ static const struct resource dispcc_res[] = {
 static const struct resource mdss_mem =
 	DEFINE_RES_MEM_NAMED(0xae00000, 0x1000, "mdss");
 
+static const struct resource dpu_mem[] = {
+	DEFINE_RES_MEM_NAMED(0xae01000, 0x8f000, "mdp"),
+	DEFINE_RES_MEM_NAMED(0xaeb0000, 0x3000, "vbif"),
+};
+
 static const struct resource phy_res[] = {
 	DEFINE_RES_MEM_NAMED(0xae94400, 0x200, "dsi_phy"),
 	DEFINE_RES_MEM_NAMED(0xae94600, 0x280, "dsi_phy_lane"),
@@ -95,7 +102,7 @@ static int check_firmware(void)
 	acpi_handle handle;
 	LIST_HEAD(resources);
 	bool contains = false, contains_mdss = false;
-	unsigned int phy_windows = 0;
+	unsigned int phy_windows = 0, dpu_windows = 0;
 	unsigned int i;
 	int ret;
 
@@ -129,6 +136,9 @@ static int check_firmware(void)
 		if (resource_type(entry->res) != IORESOURCE_MEM ||
 		    entry->res->flags & IORESOURCE_DISABLED)
 			continue;
+		for (i = 0; i < ARRAY_SIZE(dpu_mem); i++)
+			if (resource_contains(entry->res, &dpu_mem[i]))
+				dpu_windows |= BIT(i);
 		if (resource_contains(entry->res, &mdss_mem))
 			contains_mdss = true;
 		if (resource_contains(entry->res, &dispcc_res[0]))
@@ -139,6 +149,7 @@ static int check_firmware(void)
 	}
 	acpi_dev_free_resource_list(&resources);
 	if (contains && contains_mdss && mdss_irq > 0 &&
+	    dpu_windows == GENMASK(ARRAY_SIZE(dpu_mem) - 1, 0) &&
 	    phy_windows == GENMASK(ARRAY_SIZE(phy_res) - 1, 0))
 		return 0;
 	ret = -EINVAL;
@@ -389,10 +400,78 @@ static int prepare_mdss(void)
 	return tcl_display_stage_activate(&mdss);
 }
 
+
+/* Keep DPU probe blocked until the DSI component graph is complete. */
+static int prepare_dpu(struct generic_pm_domain *cx)
+{
+	static const char * const clock_names[] = {
+		"bus", "iface", "rot", "lut", "core", "vsync",
+	};
+	static const char * const sources[] = {
+		"gcc_disp_hf_axi_clk", "disp_cc_mdss_ahb_clk",
+		"disp_cc_mdss_rot_clk", "disp_cc_mdss_mdp_lut_clk",
+		"disp_cc_mdss_mdp_clk", "disp_cc_mdss_vsync_clk",
+	};
+	const struct property_entry dpu_props[] = {
+		PROPERTY_ENTRY_BOOL("qcom,tcl-acpi-display"),
+		PROPERTY_ENTRY_STRING_ARRAY("clock-names", clock_names),
+		{ }
+	};
+	struct resource resources[] = {
+		dpu_mem[0], dpu_mem[1],
+		DEFINE_RES_IRQ_NAMED(0, "dpu"),
+	};
+	struct irq_domain *domain;
+	unsigned int i;
+	int ret;
+
+	domain = irq_find_matching_fwnode(dev_fwnode(&mdss.pdev->dev), DOMAIN_BUS_ANY);
+	if (!domain)
+		return -EPROBE_DEFER;
+	dpu_irq = irq_create_mapping(domain, 0);
+	if (!dpu_irq)
+		return -ENOMEM;
+	resources[2].start = resources[2].end = dpu_irq;
+	ret = tcl_display_stage_create(&dpu, "tcl-sc7180-dpu", &mdss.pdev->dev,
+			resources, ARRAY_SIZE(resources), dpu_props);
+	if (ret) {
+		irq_dispose_mapping(dpu_irq);
+		dpu_irq = 0;
+		return ret;
+	}
+	/* From here on retain IRQ and device with the other diagnostic stages. */
+	ret = link_supplier(&dpu, rpmhpd);
+	if (ret)
+		return ret;
+	ret = link_supplier(&dpu, &gcc.pdev->dev);
+	if (ret)
+		return ret;
+	ret = link_supplier(&dpu, &dispcc.pdev->dev);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(noc); i++) {
+		ret = link_supplier(&dpu, &noc[i].pdev->dev);
+		if (ret)
+			return ret;
+	}
+	for (i = 0; i < ARRAY_SIZE(clock_names); i++) {
+		ret = tcl_display_stage_clock(&dpu,
+			dev_name(i ? &dispcc.pdev->dev : &gcc.pdev->dev),
+			sources[i], clock_names[i]);
+		if (ret)
+			return ret;
+	}
+	ret = tcl_display_stage_domain(&dpu, cx);
+	if (ret)
+		return ret;
+	pr_info("TCL DPU resources ready; probe held for DSI component graph\n");
+	return 0;
+}
+
 static int block_pending_probes(void)
 {
 	struct tcl_display_stage *stages[] = {
-		&mdss, &phy, &phy_reg, &dispcc, &gcc,
+		&dpu, &mdss, &phy, &phy_reg, &dispcc, &gcc,
 		&noc[4], &noc[3], &noc[2], &noc[1], &noc[0], &bcm,
 	};
 	int first = 0, ret;
@@ -449,6 +528,8 @@ static int __init tcl_display_init(void)
 		result = prepare_phy();
 	if (!result)
 		result = prepare_mdss();
+	if (!result)
+		result = prepare_dpu(domains->domains[SC7180_CX]);
 	ready = !result;
 	if (result) {
 		/* Keep ownership after any partial setup, including deferred probe.
