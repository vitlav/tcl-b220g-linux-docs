-		if (!ret && gcc.pdev)
-			ret = device_set_driver_override(&gcc.pdev->dev,
-					TCL_DISPLAY_STAGE_BLOCK);
+		ret = block_pending_probes();
 		pr_err("TCL display clocks stopped: result=%d block=%d; resources retained\n",
 		       result, ret);
 	} else {
-		pr_info("TCL display clock providers ready; scanout not enabled\n");
+		pr_info("TCL display clocks and DSI PHY ready; scanout not enabled\n");
 	}
 	return 0;
 put_pd:
@@ -207,3 +327,4 @@ static int __init tcl_display_init(void)
 module_init(tcl_display_init);
 MODULE_LICENSE("GPL");
 MODULE_DESCRIPTION("TCL B220G diagnostic ACPI display clock coordinator, no unload");
