 drivers/soc/qcom/tcl_acpi_display.c       | 145 ++++++++++++++++++++--
 drivers/soc/qcom/tcl_acpi_display_stage.h |  20 ++-
 3 files changed, 151 insertions(+), 16 deletions(-)

