#!/bin/sh
set -eu

ready=no
for attempt in $(seq 1 120); do
	ready=yes
	for provider in qcom-sc7180-rpmhpd qcom-sc7180-rpmhcc qcom-apss-shared qcom_aoss_qmp; do
		if [ ! -L "/sys/bus/platform/devices/$provider/driver" ]; then
			ready=no
			break
		fi
	done
	[ "$ready" = yes ] && break
	sleep 1
done
[ "$ready" = yes ] || { echo "audio providers did not bind in time" >&2; exit 1; }

for module in \
	qcom_q6v5_pas apr q6core q6afe q6afe-clocks q6afe-dai \
	q6adm q6asm q6asm-dai q6routing snd-q6dsp-common \
	snd-soc-lpass-macro-common snd-soc-lpass-va-macro \
	snd-soc-lpass-rx-macro snd-soc-lpass-tx-macro \
	soundwire-qcom snd-soc-wcd-common snd-soc-wcd-mbhc \
	snd-soc-wcd938x snd-soc-wcd938x-sdw tcl_acpi_audio; do
	modprobe "$module"
done

# The ACPI coordinator creates the TCL Q6AFE clock aliases. Register the
# SC7280 LPI driver first, then its board-guarded SoundWire pinctrl provider.
modprobe pinctrl_sc7280_lpass_lpi
modprobe tcl_lpi_provider

provider=/sys/bus/platform/devices/tcl-lpi-provider.0
for attempt in $(seq 1 30); do
	if [ -L "$provider/driver" ] &&
	   dmesg | grep -Fq 'TCL ACPI SoundWire LPI pinmux configured'; then
		break
	fi
	sleep 1
done
[ -L "$provider/driver" ] || {
	echo "TCL ACPI SoundWire LPI provider did not bind" >&2
	exit 1
}
dmesg | grep -Fq 'TCL ACPI SoundWire LPI pinmux configured' || {
	echo "TCL ACPI SoundWire LPI pinmux was not configured" >&2
	exit 1
}
