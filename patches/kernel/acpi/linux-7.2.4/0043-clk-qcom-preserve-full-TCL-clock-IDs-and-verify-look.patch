diff --git a/drivers/soc/qcom/tcl_acpi_display_stage.h b/drivers/soc/qcom/tcl_acpi_display_stage.h
index a988599f3f34a84b13c292788e4412cb56d900ce..cb3ad84492578e6ae700dd03cdf77503644b36a3 100644
--- a/drivers/soc/qcom/tcl_acpi_display_stage.h
