From ffa084cabd9997491b75a1f9cfb72338561f29f3 Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 15:10:55 +0300
Subject: [PATCH 36/58] drm/msm/dsi: accept firmware PHY references and lane
 descriptions

---
 drivers/gpu/drm/msm/dsi/dsi.c      | 27 ++++++++++++++
 drivers/gpu/drm/msm/dsi/dsi_host.c | 60 +++++++++++++++---------------
 2 files changed, 57 insertions(+), 30 deletions(-)

diff --git a/drivers/gpu/drm/msm/dsi/dsi.c b/drivers/gpu/drm/msm/dsi/dsi.c
index 3c9f01ed62713313b2cfe8147415bc8733247cb7..ab6231967519528b629786d038d68ca76abe4643 100644
--- a/drivers/gpu/drm/msm/dsi/dsi.c
+++ b/drivers/gpu/drm/msm/dsi/dsi.c
@@ -3,6 +3,8 @@
  * Copyright (c) 2015, The Linux Foundation. All rights reserved.
  */
 
+#include <linux/property.h>
+
 #include "dsi.h"
 
 bool msm_dsi_is_cmd_mode(struct msm_dsi *msm_dsi)
@@ -28,6 +30,31 @@ static int dsi_get_phy(struct msm_dsi *msm_dsi)
 	struct platform_device *phy_pdev;
 	struct device_node *phy_node;
 
+	if (!pdev->dev.of_node) {
+		struct fwnode_handle *ref;
+		struct device *phy_dev;
+		int ret = 0;
+
+		ref = fwnode_find_reference(dev_fwnode(&pdev->dev), "phys", 0);
+		if (IS_ERR(ref))
+			return PTR_ERR(ref);
+		phy_dev = bus_find_device_by_fwnode(&platform_bus_type, ref);
+		fwnode_handle_put(ref);
+		if (!phy_dev)
+			return -EPROBE_DEFER;
+		device_lock(phy_dev);
+		if (!device_is_bound(phy_dev) || !dev_get_drvdata(phy_dev)) {
+			ret = -EPROBE_DEFER;
+		} else {
+			msm_dsi->phy = dev_get_drvdata(phy_dev);
+			msm_dsi->phy_dev = phy_dev;
+		}
+		device_unlock(phy_dev);
+		if (ret)
+			put_device(phy_dev);
+		return ret;
+	}
+
 	phy_node = of_parse_phandle(pdev->dev.of_node, "phys", 0);
 	if (!phy_node) {
 		DRM_DEV_ERROR(&pdev->dev, "cannot find phy device\n");
diff --git a/drivers/gpu/drm/msm/dsi/dsi_host.c b/drivers/gpu/drm/msm/dsi/dsi_host.c
index 982abaaac00d538d6bbfcdb2eaf80c3adcc265ef..8eed25bdf97126e782c14c31559af55a0121a0f7 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -11,6 +11,7 @@
 #include <linux/mfd/syscon.h>
 #include <linux/of.h>
 #include <linux/of_graph.h>
+#include <linux/property.h>
 #include <linux/of_irq.h>
 #include <linux/pinctrl/consumer.h>
 #include <linux/pm_opp.h>
@@ -1802,15 +1803,15 @@ static const int supported_data_lane_swaps[][4] = {
 };
 
 static int dsi_host_parse_lane_data(struct msm_dsi_host *msm_host,
-				    struct device_node *ep)
+				    struct fwnode_handle *ep)
 {
 	struct device *dev = &msm_host->pdev->dev;
-	struct property *prop;
 	u32 lane_map[4];
-	int ret, i, len, num_lanes;
+	int ret, i, num_lanes;
 
-	prop = of_find_property(ep, "data-lanes", &len);
-	if (!prop) {
+	if (!fwnode_property_present(ep, "data-lanes")) {
+		if (!dev->of_node)
+			return -EINVAL;
 		DRM_DEV_DEBUG(dev,
 			"failed to find data lane mapping, using default\n");
 		/* Set the number of date lanes to 4 by default. */
@@ -1818,15 +1819,15 @@ static int dsi_host_parse_lane_data(struct msm_dsi_host *msm_host,
 		return 0;
 	}
 
-	num_lanes = drm_of_get_data_lanes_count(ep, 1, 4);
-	if (num_lanes < 0) {
+	num_lanes = fwnode_property_count_u32(ep, "data-lanes");
+	if (num_lanes < 1 || num_lanes > 4) {
 		DRM_DEV_ERROR(dev, "bad number of data lanes\n");
-		return num_lanes;
+		return num_lanes < 0 ? num_lanes : -EINVAL;
 	}
 
 	msm_host->num_data_lanes = num_lanes;
 
-	ret = of_property_read_u32_array(ep, "data-lanes", lane_map,
+	ret = fwnode_property_read_u32_array(ep, "data-lanes", lane_map,
 					 num_lanes);
 	if (ret) {
 		DRM_DEV_ERROR(dev, "failed to read lane data\n");
@@ -1849,9 +1850,11 @@ static int dsi_host_parse_lane_data(struct msm_dsi_host *msm_host,
 		 * configuration that works.
 		 */
 		for (j = 0; j < num_lanes; j++) {
-			if (lane_map[j] < 0 || lane_map[j] > 3)
+			if (lane_map[j] > 3) {
 				DRM_DEV_ERROR(dev, "bad physical lane entry %u\n",
 					lane_map[j]);
+				return -EINVAL;
+			}
 
 			if (swap[lane_map[j]] != j)
 				break;
@@ -1912,12 +1915,12 @@ static int dsi_populate_dsc_params(struct msm_dsi_host *msm_host, struct drm_dsc
 	return drm_dsc_compute_rc_parameters(dsc);
 }
 
-static int dsi_host_parse_dt(struct msm_dsi_host *msm_host)
+static int dsi_host_parse_firmware(struct msm_dsi_host *msm_host)
 {
 	struct msm_dsi *msm_dsi = platform_get_drvdata(msm_host->pdev);
 	struct device *dev = &msm_host->pdev->dev;
 	struct device_node *np = dev->of_node;
-	struct device_node *endpoint;
+	struct fwnode_handle *endpoint;
 	const char *te_source;
 	int ret = 0;
 
@@ -1927,10 +1930,11 @@ static int dsi_host_parse_dt(struct msm_dsi_host *msm_host)
 	 * the remote endpoint isn't defined. It's possible that there is
 	 * nothing connected to the dsi output.
 	 */
-	endpoint = of_graph_get_endpoint_by_regs(np, 1, -1);
+	endpoint = np ? of_fwnode_handle(of_graph_get_endpoint_by_regs(np, 1, -1)) :
+		fwnode_graph_get_endpoint_by_id(dev_fwnode(dev), 1, 0, 0);
 	if (!endpoint) {
 		DRM_DEV_DEBUG(dev, "%s: no endpoint\n", __func__);
-		return 0;
+		return np ? 0 : -EINVAL;
 	}
 
 	ret = dsi_host_parse_lane_data(msm_host, endpoint);
@@ -1941,24 +1945,19 @@ static int dsi_host_parse_dt(struct msm_dsi_host *msm_host)
 		goto err;
 	}
 
-	ret = of_property_read_string(endpoint, "qcom,te-source", &te_source);
-	if (ret && ret != -EINVAL) {
-		DRM_DEV_ERROR(dev, "%s: invalid TE source configuration %d\n",
-			__func__, ret);
-		goto err;
-	}
-	if (!ret) {
+	if (fwnode_property_present(endpoint, "qcom,te-source")) {
+		ret = fwnode_property_read_string(endpoint, "qcom,te-source", &te_source);
+		if (ret)
+			goto err;
 		msm_dsi->te_source = devm_kstrdup(dev, te_source, GFP_KERNEL);
 		if (!msm_dsi->te_source) {
-			DRM_DEV_ERROR(dev, "%s: failed to allocate te_source\n",
-				__func__);
 			ret = -ENOMEM;
 			goto err;
 		}
 	}
 	ret = 0;
 
-	if (of_property_present(np, "syscon-sfpb")) {
+	if (np && of_property_present(np, "syscon-sfpb")) {
 		msm_host->sfpb = syscon_regmap_lookup_by_phandle(np,
 					"syscon-sfpb");
 		if (IS_ERR(msm_host->sfpb)) {
@@ -1969,7 +1968,7 @@ static int dsi_host_parse_dt(struct msm_dsi_host *msm_host)
 	}
 
 err:
-	of_node_put(endpoint);
+	fwnode_handle_put(endpoint);
 
 	return ret;
 }
@@ -2007,9 +2006,9 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	msm_host->pdev = pdev;
 	msm_dsi->host = &msm_host->base;
 
-	ret = dsi_host_parse_dt(msm_host);
+	ret = dsi_host_parse_firmware(msm_host);
 	if (ret)
-		return dev_err_probe(&pdev->dev, ret, "%s: failed to parse dt\n",
+		return dev_err_probe(&pdev->dev, ret, "%s: failed to parse firmware\n",
 				     __func__);
 
 	msm_host->ctrl_base = msm_ioremap_size(pdev, "dsi_ctrl", &msm_host->ctrl_size);
@@ -2057,9 +2056,10 @@ int msm_dsi_host_init(struct msm_dsi *msm_dsi)
 	if (ret && ret != -ENODEV)
 		return dev_err_probe(&pdev->dev, ret, "invalid OPP table in device tree\n");
 
-	msm_host->irq = irq_of_parse_and_map(pdev->dev.of_node, 0);
-	if (!msm_host->irq)
-		return dev_err_probe(&pdev->dev, -EINVAL, "failed to get irq\n");
+	ret = platform_get_irq(pdev, 0);
+	if (ret < 0)
+		return dev_err_probe(&pdev->dev, ret, "failed to get irq\n");
+	msm_host->irq = ret;
 
 	/* do not autoenable, will be enabled later */
 	ret = devm_request_irq(&pdev->dev, msm_host->irq, dsi_host_irq,
