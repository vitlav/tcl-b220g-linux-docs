@@ -1083,8 +1087,17 @@ static int clk_rpmh_probe(struct platform_device *pdev)
 			dev_err(&pdev->dev, "failed to register %s\n", name);
 			return ret;
 		}
+		if (!pdev->dev.of_node) {
+			ret = devm_clk_hw_register_clkdev(&pdev->dev, hw_clks[i],
