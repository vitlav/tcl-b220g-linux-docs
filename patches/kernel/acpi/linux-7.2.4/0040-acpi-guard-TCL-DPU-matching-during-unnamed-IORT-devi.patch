From acb35aba6e1efdde2036c3cabeaae4974400dd8d Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 17:34:51 +0300
Subject: [PATCH 40/58] acpi: guard TCL DPU matching during unnamed IORT device
 setup

---
 drivers/acpi/arm64/iort.c | 2 +-
 drivers/acpi/scan.c       | 5 ++++-
 drivers/base/platform.c   | 4 ++--
 3 files changed, 7 insertions(+), 4 deletions(-)

diff --git a/drivers/acpi/arm64/iort.c b/drivers/acpi/arm64/iort.c
index fef144737e460833e313e6d6f8329e5693b1e823..3ee887b247bce3a72b7abdfb7a66383070403910 100644
--- a/drivers/acpi/arm64/iort.c
+++ b/drivers/acpi/arm64/iort.c
@@ -1683,7 +1683,7 @@ int iort_iommu_configure_id(struct device *dev, const u32 *id_in)
 		if (!node)
 			return -ENODEV;
 
-		if (!dev->of_node && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
+		if (!dev->of_node && dev_name(dev) && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
 		    device_property_read_bool(dev, "qcom,tcl-acpi-display")) {
 			/* GPU0 PASID/stall flags describe a composite device, not
 			 * this display engine. Keep the board's software node.
diff --git a/drivers/acpi/scan.c b/drivers/acpi/scan.c
index a8e13d3b6766d8b739cee5ed054eeb98b431f03a..945e1d8694dc4ade7a74a65f479d3b0a3b2784c7 100644
--- a/drivers/acpi/scan.c
+++ b/drivers/acpi/scan.c
@@ -1601,7 +1601,10 @@ int acpi_dma_get_range(struct device *dev, const struct bus_dma_region **map)
 
 static bool acpi_tcl_dpu_strict_dma(struct device *dev)
 {
-	return !dev->of_node && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
+	/* IORT configures SMMU DMA before platform_device_add() assigns a name. */
+	const char *name = dev_name(dev);
+
+	return name && !dev->of_node && !strcmp(name, "tcl-sc7180-dpu") &&
 		device_property_read_bool(dev, "qcom,tcl-acpi-display");
 }
 
diff --git a/drivers/base/platform.c b/drivers/base/platform.c
index f0a3b0b23745f47a6f3989b9140c5496bf6b37f9..06e44fb2bd04af9ad75f9b578bbcfc255545b1f8 100644
--- a/drivers/base/platform.c
+++ b/drivers/base/platform.c
@@ -1481,7 +1481,7 @@ static int platform_dma_configure(struct device *dev)
 	} else if (is_acpi_device_node(fwnode)) {
 		attr = acpi_get_dma_attr(to_acpi_device_node(fwnode));
 		ret = acpi_dma_configure(dev, attr);
-	} else if (!strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
+	} else if (dev_name(dev) && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
 		   device_property_read_bool(dev, "qcom,tcl-acpi-display")) {
 		struct acpi_device *adev;
 
@@ -1498,7 +1498,7 @@ static int platform_dma_configure(struct device *dev)
 	if (ret || !drv || to_platform_driver(drv)->driver_managed_dma)
 		return ret;
 
-	if (!strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
+	if (dev_name(dev) && !strcmp(dev_name(dev), "tcl-sc7180-dpu") &&
 	    device_property_read_bool(dev, "qcom,tcl-acpi-display")) {
 		struct iommu_domain *domain = iommu_get_domain_for_dev(dev);
 
