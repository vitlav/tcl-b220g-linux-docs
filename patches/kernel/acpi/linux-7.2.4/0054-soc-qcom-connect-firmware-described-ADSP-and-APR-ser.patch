 drivers/soc/qcom/apr.c             | 152 +++++++++++++++++------------
 5 files changed, 127 insertions(+), 72 deletions(-)

diff --git a/drivers/remoteproc/qcom_common.c b/drivers/remoteproc/qcom_common.c
index 141aaf2837355a5d863cfd9d7e8f1ba0abb95af0..ecde6b260af0426336b52fd2e13a3e0afc03f6a0 100644
--- a/drivers/remoteproc/qcom_common.c
+++ b/drivers/remoteproc/qcom_common.c
@@ -231,6 +231,12 @@ static void glink_subdev_stop(struct rproc_subdev *subdev, bool crashed)
 {
 	struct qcom_rproc_glink *glink = to_glink_subdev(subdev);
 
+	/* The subdevice may not have started, or may already have been stopped. */
+	if (IS_ERR_OR_NULL(glink->edge)) {
+		glink->edge = NULL;
+		return;
+	}
+
 	qcom_glink_smem_unregister(glink->edge);
 	glink->edge = NULL;
 }
