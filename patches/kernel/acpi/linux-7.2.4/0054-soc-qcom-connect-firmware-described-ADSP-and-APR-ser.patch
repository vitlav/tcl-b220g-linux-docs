+};
+
 static const struct platform_device_id qcom_pas_platform_ids[] = {
+	{ "tcl-sc7180-adsp", (kernel_ulong_t)&tcl_sc7180_adsp_resource },
 	{ "tcl-sc7180-mpss", (kernel_ulong_t)&mpss_resource_init },
