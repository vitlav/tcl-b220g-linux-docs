From e4db8bb0308eb8ea5f881fc296e711760e03eceb Mon Sep 17 00:00:00 2001
From: Vitaly Lipatov <lav@etersoft.ru>
Date: Fri, 11 Sep 2026 11:43:40 +0300
Subject: [PATCH 07/16] soc: qcom: support firmware-described SMEM and
 signaling

Port the ACPI9 implementation to vanilla v7.2.4. Affected ARM64 objects build with W=1. Keep upstream GLINK endpoint removal and reserved-memory resource handling. Full build and hardware validation are separate gates; this commit does not claim hardware validation.
---
 drivers/hwspinlock/qcom_hwspinlock.c    | 18 ++++++++--
 drivers/mailbox/qcom-apcs-ipc-mailbox.c | 17 +++++++++-
 drivers/soc/qcom/smem.c                 | 30 ++++++++++++++---
 drivers/soc/qcom/smem_state.c           | 45 ++++++++++++++-----------
 drivers/soc/qcom/smp2p.c                | 24 +++++++------
 include/linux/soc/qcom/smem_state.h     | 10 ++++++
 6 files changed, 107 insertions(+), 37 deletions(-)

diff --git a/drivers/hwspinlock/qcom_hwspinlock.c b/drivers/hwspinlock/qcom_hwspinlock.c
index 712003a46..1d5150a3a 100644
--- a/drivers/hwspinlock/qcom_hwspinlock.c
+++ b/drivers/hwspinlock/qcom_hwspinlock.c
@@ -185,8 +185,14 @@ static struct regmap *qcom_hwspinlock_probe_mmio(struct platform_device *pdev,
 	struct device *dev = &pdev->dev;
 	void __iomem *base;
 
-	data = of_device_get_match_data(dev);
-	if (!data->regmap_config)
+	data = device_get_match_data(dev);
+	if (!data) {
+		const struct platform_device_id *id = platform_get_device_id(pdev);
+
+		if (id)
+			data = (const void *)id->driver_data;
+	}
+	if (!data || !data->regmap_config)
 		return ERR_PTR(-EINVAL);
 
 	*offset = data->offset;
@@ -235,8 +241,16 @@ static int qcom_hwspinlock_probe(struct platform_device *pdev)
 					 0, QCOM_MUTEX_NUM_LOCKS);
 }
 
+/* Used by firmware-specific board code providing the MMIO resource. */
+static const struct platform_device_id qcom_hwspinlock_platform_ids[] = {
+	{ "qcom-tcsr-mutex", (kernel_ulong_t)&of_tcsr_mutex },
+	{ }
+};
+MODULE_DEVICE_TABLE(platform, qcom_hwspinlock_platform_ids);
+
 static struct platform_driver qcom_hwspinlock_driver = {
 	.probe		= qcom_hwspinlock_probe,
+	.id_table	= qcom_hwspinlock_platform_ids,
 	.driver		= {
 		.name	= "qcom_hwspinlock",
 		.of_match_table = qcom_hwspinlock_of_match,
