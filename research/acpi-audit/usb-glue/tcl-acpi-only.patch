+/* Diagnostic TCL-only adaptation. DMA must be configured by the bus before
+ * probe, so default-domain ownership is established by the driver core.
+ * Do not repair a missing IORT mapping here after platform_dma_configure().
+ */
+static int tcl_acpi_usb_check(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct acpi_device *adev = ACPI_COMPANION(dev);
+	struct iommu_fwspec *fwspec;
+	struct resource *res;
+	char path[64];
+	struct acpi_buffer name = { sizeof(path), path };
+
+	if (dev->of_node || !adev ||
+	    !acpi_dev_hid_uid_match(adev, "QCOM0897", NULL))
+		return -ENODEV;
+	if (ACPI_FAILURE(acpi_get_name(adev->handle, ACPI_FULL_PATHNAME, &name)) ||
+	    strcmp(path, "\\_SB.URS0"))
+		return dev_err_probe(dev, -ENODEV, "unexpected ACPI USB parent\n");
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || res->start != 0x0a600000 || resource_size(res) != 0x000fffff)
+		return dev_err_probe(dev, -EINVAL, "unexpected TCL USB memory resource\n");
+	if (!adev->flags.cca_seen || adev->flags.coherent_dma)
+		return dev_err_probe(dev, -EINVAL, "TCL USB requires _CCA=0\n");
+	fwspec = dev_iommu_fwspec_get(dev);
+	if (!fwspec || fwspec->num_ids != 1 || fwspec->ids[0] != 0x540 ||
+	    !iommu_get_domain_for_dev(dev))
+		return dev_err_probe(dev, -ENODEV,
+			"TCL USB IORT mapping/domain missing: input 0x80030000 -> SID 0x540\n");
+	return 0;
 }
 
