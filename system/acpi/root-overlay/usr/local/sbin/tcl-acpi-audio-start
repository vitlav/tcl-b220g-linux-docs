#!/bin/sh
set -eu

adsp=
for remoteproc in /sys/class/remoteproc/remoteproc*; do
	[ -r "$remoteproc/name" ] || continue
	if [ "$(cat "$remoteproc/name")" = adsp ]; then
		adsp=$remoteproc
		break
	fi
done

[ -n "$adsp" ] || { echo "ADSP remoteproc is not registered" >&2; exit 1; }

state=$(cat "$adsp/state")
if [ "$state" != running ]; then
	echo start > "$adsp/state"
fi

for attempt in $(seq 1 120); do
	if find /sys/devices -type d -name 'aprsvc:q6adm:4:8' -print -quit 2>/dev/null | grep -q .; then
		break
	fi
	sleep 1
done

if ! find /sys/devices -type d -name 'aprsvc:q6adm:4:8' -print -quit 2>/dev/null | grep -q .; then
	echo "ADSP did not register APR q6adm within 120 seconds" >&2
	exit 1
fi

# The q6afe clock aliases used by the LPI provider become available only after
# ADSP has registered its APR services. The pinctrl driver was loaded by the
# prepare unit; register the board provider now and verify the actual pinmux.
modprobe pinctrl_sc7280_lpass_lpi
modprobe tcl_lpi_provider
lpi_provider=/sys/bus/platform/devices/tcl-lpi-provider.0
for attempt in $(seq 1 30); do
	if [ -L "$lpi_provider/driver" ] &&
	   dmesg | grep -Fq 'TCL ACPI SoundWire LPI pinmux configured'; then
		break
	fi
	sleep 1
done
[ -L "$lpi_provider/driver" ] || {
	echo "TCL ACPI SoundWire LPI provider did not bind" >&2
	exit 1
}
dmesg | grep -Fq 'TCL ACPI SoundWire LPI pinmux configured' || {
	echo "TCL ACPI SoundWire LPI pinmux was not configured" >&2
	exit 1
}

# APR may publish the LPASS children before the board LPI provider has made
# their clocks usable.  Retry only devices whose first probe therefore ended
# unbound, then require every macro and SoundWire master to be attached before
# touching codec power or reset.
for device in \
	tcl-sc7280-va tcl-sc7280-rx tcl-sc7280-tx \
	tcl-swr-rx tcl-swr-tx; do
	device_path=/sys/bus/platform/devices/$device
	[ -d "$device_path" ] || {
		echo "$device platform device is missing" >&2
		exit 1
	}
	if [ ! -L "$device_path/driver" ]; then
		echo "$device" > /sys/bus/platform/drivers_probe
	fi
	[ -L "$device_path/driver" ] || {
		echo "$device did not bind after LPI setup" >&2
		exit 1
	}
done

# Hold the two OEM AUDD audio rails for the service lifetime and run the
# board-guarded WCD reset sequence before SoundWire re-enumeration.
modprobe tcl_acpi_audio_power_hold
modprobe tcl_acpi_codec_reset_hold

rx_status=/sys/bus/soundwire/devices/sdw:2:0:0217:010d:00:4/status
tx_status=/sys/bus/soundwire/devices/sdw:3:0:0217:010d:00:3/status
rx_pm=/sys/bus/platform/devices/tcl-swr-rx/power/control
tx_pm=/sys/bus/platform/devices/tcl-swr-tx/power/control

for attempt in $(seq 1 60); do
	if [ -r "$rx_status" ] && [ -r "$tx_status" ] &&
	   [ "$(cat "$rx_status")" = Attached ] &&
	   [ "$(cat "$tx_status")" = Attached ]; then
		break
	fi
	if [ "$attempt" = 1 ]; then
		[ -w "$rx_pm" ] && [ -w "$tx_pm" ] || {
			echo "SoundWire runtime-PM controls are unavailable" >&2
			exit 1
		}
		echo auto > "$rx_pm"
		echo auto > "$tx_pm"
		sleep 2
		echo on > "$rx_pm"
		echo on > "$tx_pm"
	fi
	sleep 1
done

if [ "$(cat "$rx_status")" != Attached ] ||
	[ "$(cat "$tx_status")" != Attached ]; then
	echo "WCD9385 SoundWire RX/TX did not attach" >&2
	exit 1
fi

# Register the WCD aggregate and playback card only after both slaves attach.
modprobe tcl_acpi_wcd
modprobe tcl_acpi_card

if ! grep -Fq 'TCL B220G ACPI Audio' /proc/asound/cards; then
	echo "TCL B220G ACPI Audio did not register" >&2
	exit 1
fi

/usr/sbin/alsactl --no-ucm restore 0
# Validate that all persistent speaker controls exist and can be read back.
# Do not force fixed values here: alsamixer mute and volume choices are state.
for control in \
	'HPHL Volume' 'HPHR Volume' \
	'RX_RX0 Digital Volume' 'RX_RX1 Digital Volume' \
	'HPHL Switch' 'HPHR Switch' 'Internal Speaker Switch'; do
	amixer -c 0 cget name="$control" >/dev/null
done
